@model IReadOnlyList<EduCenterManagement.Models.AppUser>
@{ViewData["Title"]="Development tools";}<h1>Development users</h1><p><a class="btn btn-primary" href="/Dev/Seed">Create seed data</a></p><table class="table"><thead><tr><th>Id</th><th>Email</th><th>Role</th><th>Links</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Id</td><td>@u.Email</td><td>@u.Role</td><td><a href="/StudentTimetable?userId=@u.Id">Timetable</a> <a href="/ParentChildren?userId=@u.Id">Children</a> <a href="/TeacherComment?userId=@u.Id">Comments</a> <a href="/Notification?userId=@u.Id">Notifications</a></td></tr>}</tbody></table>
