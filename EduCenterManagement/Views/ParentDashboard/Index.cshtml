@model EduCenterManagement.ViewModels.Dashboard.ParentDashboardViewModel

@{
    ViewData["Title"] = "Tổng quan phụ huynh";
}

<div class="container-fluid px-0" style="max-width: 1150px;">
    <div class="mb-4">
        <span class="badge bg-primary-subtle text-primary border mb-2">Parent Portal</span>
        <h1 class="fw-bold mb-1">Xin chào, @Model.FullName</h1>
        <p class="text-muted mb-0">Tổng quan nhanh về tài khoản phụ huynh của bạn.</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-4 d-flex align-items-center gap-3"><div class="bg-primary-subtle text-primary rounded-3 p-3"><i class="bi bi-people fs-3"></i></div><div><div class="text-muted">Học sinh đã liên kết</div><div class="display-6 fw-bold">@Model.LinkedStudents.Count</div></div></div></div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-4 d-flex align-items-center gap-3"><div class="bg-warning-subtle text-warning rounded-3 p-3"><i class="bi bi-hourglass-split fs-3"></i></div><div><div class="text-muted">Yêu cầu đang chờ</div><div class="display-6 fw-bold">@Model.PendingRequests.Count</div></div></div></div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-4 d-flex align-items-center gap-3"><div class="bg-success-subtle text-success rounded-3 p-3"><i class="bi bi-bell fs-3"></i></div><div><div class="text-muted">Thông báo gần đây</div><div class="display-6 fw-bold">@Model.Notifications.Count</div></div></div></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3"><h5 class="mb-0"><i class="bi bi-bell me-2 text-primary"></i>Thông báo gần đây</h5></div>
        <div class="card-body">
            @if (!Model.Notifications.Any())
            {
                <p class="text-muted mb-0">Chưa có thông báo.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Notifications)
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="fw-semibold">@item.Title</div>
                            <div>@item.Message</div>
                            <div class="text-muted small mt-1">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
