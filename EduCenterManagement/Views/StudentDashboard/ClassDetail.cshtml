@using EduCenterManagement.Enums
@model EduCenterManagement.ViewModels.Student.ClassDetailViewModel

@{
    ViewData["Title"] = $"Chi tiết lớp học - {Model.ClassName}";
}

<div class="container mt-4 mb-5" style="max-width: 1050px;">
    <!-- Breadcrumb & Nav -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại thời khóa biểu
        </a>
    </div>

    <!-- Thông tin Lớp học -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="badge bg-primary mb-2">@Model.SubjectName</span>
                    <h2 class="h3 fw-bold text-dark mb-1">@Model.ClassName</h2>
                    <p class="text-muted mb-0">@Model.SubjectDescription</p>
                </div>
                <div class="text-md-end">
                    <span class="badge @(Model.Status == ClassStatus.InProgress ? "bg-success" : "bg-info") fs-6 px-3 py-2">
                        @Model.Status
                    </span>
                </div>
            </div>

            <hr class="my-3" />

            <div class="row g-3">
                <div class="col-sm-6 col-md-3">
                    <div class="text-muted small">Giáo viên phụ trách</div>
                    <div class="fw-semibold text-dark fs-6">
                        <i class="bi bi-person-badge me-1 text-primary"></i>@Model.TeacherName
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="text-muted small">Thời gian khóa học</div>
                    <div class="fw-semibold text-dark fs-6">
                        @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="text-muted small">Tổng số buổi học</div>
                    <div class="fw-semibold text-dark fs-6">
                        <i class="bi bi-calendar-check me-1 text-primary"></i>@Model.Sessions.Count buổi
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="text-muted small">Học phí</div>
                    <div class="fw-semibold text-success fs-6">
                        @Model.Fee.ToString("N0") VNĐ
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách các buổi học & Slide bài giảng -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-collection-play me-2 text-primary"></i>Danh Sách Buổi Học &amp; Tài Liệu (Slides)
            </h5>
            <span class="text-muted small">BR21: Đã xác thực thanh toán (Paid Enrollment)</span>
        </div>
        <div class="card-body p-3">
            @if (!Model.Sessions.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                    Chưa có buổi học nào được tạo cho lớp này.
                </div>
            }
            else
            {
                <div class="accordion" id="sessionsAccordion">
                    @foreach (var session in Model.Sessions)
                    {
                        var isCollapseOpen = session.Slides.Any() ? "show" : "";
                        var headingId = $"heading{session.SessionId}";
                        var collapseId = $"collapse{session.SessionId}";

                        <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-none">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button @(string.IsNullOrEmpty(isCollapseOpen) ? "collapsed" : "") bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(string.IsNullOrEmpty(isCollapseOpen) ? "false" : "true")" aria-controls="@collapseId">
                                    <div class="d-flex flex-wrap align-items-center gap-3 w-100 me-3">
                                        <span class="badge bg-primary rounded-pill px-3 py-2">
                                            Buổi @session.SessionNumber
                                        </span>
                                        <span class="fw-bold text-dark">
                                            @session.SessionDate.ToString("dd/MM/yyyy")
                                        </span>
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            @session.StartsAt.ToString("HH:mm") - @session.EndsAt.ToString("HH:mm")
                                        </span>
                                        <div class="ms-auto me-2">
                                            @if (session.Slides.Any())
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="bi bi-file-earmark-slides me-1"></i>@session.Slides.Count Slide(s)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">
                                                    Chưa có Slide
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse @isCollapseOpen" aria-labelledby="@headingId" data-bs-parent="#sessionsAccordion">
                                <div class="accordion-body bg-white p-3">
                                    @if (!session.Slides.Any())
                                    {
                                        <p class="text-muted mb-0 small fst-italic">
                                            <i class="bi bi-info-circle me-1"></i>Giáo viên chưa đăng tải tài liệu slide cho buổi học này.
                                        </p>
                                    }
                                    else
                                    {
                                        <h6 class="fw-semibold text-muted mb-2 small text-uppercase">Tài liệu đính kèm:</h6>
                                        <div class="list-group list-group-flush border rounded-2">
                                            @foreach (var slide in session.Slides)
                                            {
                                                <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center py-2 px-3">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-file-earmark-pdf fs-4 text-danger"></i>
                                                        <div>
                                                            <div class="fw-semibold text-dark">@slide.Title</div>
                                                            <div class="text-muted small">
                                                                @(slide.OriginalFileName ?? "Tài liệu học tập")
                                                                @if (slide.FileSize.HasValue && slide.FileSize.Value > 0)
                                                                {
                                                                    <span> &bull; @(slide.FileSize.Value / 1024) KB</span>
                                                                }
                                                                <span> &bull; Tải lên: @slide.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="mt-2 mt-sm-0">
                                                        <a asp-action="DownloadSlide" asp-route-slideId="@slide.SlideId" class="btn btn-sm btn-outline-success">
                                                            <i class="bi bi-cloud-arrow-down me-1"></i>Tải slide về máy
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
