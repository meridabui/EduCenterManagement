@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Portal | EduCenter</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduCenterManagement.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f8fafc;
            overflow-x: hidden;
        }

        #studentSidebar {
            width: 260px;
            min-width: 260px;
            max-width: 260px;
            transition: all 0.3s ease;
            background-color: #ffffff;
            border-right: 1px solid #e2e8f0;
            z-index: 1040;
            /* Cố định sidebar theo chiều cao màn hình để nút Về Trang chủ / Đăng xuất luôn hiển thị */
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .sidebar-brand {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .sidebar-menu .nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.25rem;
            color: #475569;
            font-weight: 500;
            border-radius: 0.5rem;
            margin: 0.15rem 0.75rem;
            transition: all 0.2s ease;
        }

        .sidebar-menu .nav-link i {
            font-size: 1.15rem;
            margin-right: 0.75rem;
        }

        .sidebar-menu .nav-link:hover {
            color: #0d6efd;
            background-color: #f0f7ff;
        }

        .sidebar-menu .nav-link.active {
            color: #ffffff;
            background-color: #0d6efd;
            box-shadow: 0 4px 10px rgba(13, 110, 253, 0.25);
        }

        .main-wrapper {
            flex-grow: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        @@media (max-width: 991.98px) {
            #studentSidebar {
                margin-left: -260px;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
            }

            .main-wrapper main {
                padding-top: 3.75rem !important;
            }

            #studentSidebar.show {
                margin-left: 0;
                box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
            }
        }
    </style>
</head>
<body>
    <div class="d-flex min-vh-100">
        <!-- SIDEBAR BÊN TRÁI -->
        <nav id="studentSidebar" class="d-flex flex-column">
            <!-- Brand -->
            <div class="sidebar-brand d-flex align-items-center justify-content-between">
                <a asp-controller="StudentTimetable" asp-action="Index" class="text-decoration-none d-flex align-items-center">
                    <div class="bg-primary text-white rounded-3 p-2 me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5 lh-1">EduCenter</div>
                        <span class="badge bg-primary-subtle text-primary border mt-1" style="font-size: 0.7rem;">Student Portal</span>
                    </div>
                </a>
                <button type="button" class="btn-close d-lg-none" id="sidebarCloseBtn" aria-label="Close"></button>
            </div>

            <!-- Profile Snippet -->
            <div class="px-3 py-3 mx-2 my-2 bg-light rounded-3 d-flex align-items-center">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width: 40px; height: 40px;">
                    <i class="bi bi-person fs-5"></i>
                </div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate small">@(User.Identity?.Name ?? "Học sinh")</div>
                    <div class="text-success small d-flex align-items-center">
                        <span class="p-1 bg-success rounded-circle me-1" style="font-size: 0.4rem;"></span> Đang trực tuyến
                    </div>
                </div>
            </div>

            <!-- Menu navigation links -->
            <div class="sidebar-menu flex-grow-1 overflow-auto py-2">
                <div class="px-3 mb-2 text-uppercase text-muted fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Học tập</div>

                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "StudentTimetable" ? "active" : "")"
                           asp-controller="StudentTimetable"
                           asp-action="Index">
                            <i class="bi bi-calendar3"></i>
                            <span>Thời khóa biểu</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "StudentQuiz" ? "active" : "")"
                           asp-controller="StudentQuiz"
                           asp-action="Index">
                            <i class="bi bi-ui-checks"></i>
                            <span>Bài Quiz</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "StudentComment" ? "active" : "")"
                           asp-controller="StudentComment"
                           asp-action="Index">
                            <i class="bi bi-chat-left-text"></i>
                            <span>Nhận xét</span>
                        </a>
                    </li>
                </ul>

                <div class="px-3 mt-3 mb-2 text-uppercase text-muted fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Tài khoản</div>

                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "StudentDashboard" ? "active" : "")"
                           asp-controller="StudentDashboard"
                           asp-action="Index">
                            <i class="bi bi-person-badge"></i>
                            <span>Liên kết phụ huynh</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Footer Sidebar: Về trang chủ & Đăng xuất -->
            <div class="p-3 border-top bg-light">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-house-door me-2"></i> Về Trang chủ
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm w-100 d-flex align-items-center justify-content-center">
                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </nav>

        <!-- MAIN WRAPPER BÊN PHẢI -->
        <div class="main-wrapper">
            <!-- Nút mở sidebar trên màn hình nhỏ -->
            <button class="btn btn-light border shadow-sm d-lg-none position-fixed top-0 start-0 m-2" id="sidebarToggleBtn" type="button" style="z-index: 1020;">
                <i class="bi bi-list fs-5"></i>
            </button>

            <!-- Nội dung chính -->
            <main class="flex-grow-1 p-3 p-md-4">
                @RenderBody()
            </main>

            <!-- Footer nhỏ -->
            <footer class="py-3 px-4 bg-white border-top text-muted small text-center text-md-start">
                &copy; 2026 - EduCenterManagement - Cổng thông tin Học sinh
            </footer>
        </div>
    </div>

    <!-- Backdrop cho mobile sidebar -->
    <div id="sidebarBackdrop" class="d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50" style="z-index: 1030;"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const sidebar = document.getElementById('studentSidebar');
        const toggleBtn = document.getElementById('sidebarToggleBtn');
        const closeBtn = document.getElementById('sidebarCloseBtn');
        const backdrop = document.getElementById('sidebarBackdrop');

        function toggleSidebar() {
            sidebar.classList.toggle('show');
            backdrop.classList.toggle('d-none');
        }

        if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
        if (closeBtn) closeBtn.addEventListener('click', toggleSidebar);
        if (backdrop) backdrop.addEventListener('click', toggleSidebar);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
