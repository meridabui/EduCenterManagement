<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Parent Portal | EduCenter</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduCenterManagement.styles.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; }
        body { background: #f8fafc; overflow: hidden; }
        #parentSidebar {
            width: 260px;
            min-width: 260px;
            max-width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow: hidden;
            transition: .3s ease;
            background: #fff;
            border-right: 1px solid #e2e8f0;
            z-index: 1040;
        }
        .parent-brand { padding: 1.25rem 1.5rem; border-bottom: 1px solid #f1f5f9; }
        .parent-menu { min-height: 0; overflow-y: auto !important; overflow-x: hidden; }
        .parent-menu .nav-link { display: flex; align-items: center; padding: .75rem 1.25rem; color: #475569; font-weight: 500; border-radius: .5rem; margin: .15rem .75rem; transition: .2s ease; }
        .parent-menu .nav-link i { font-size: 1.15rem; margin-right: .75rem; }
        .parent-menu .nav-link:hover { color: #4f46e5; background: #eef2ff; }
        .parent-menu .nav-link.active { color: #fff; background: #4f46e5; box-shadow: 0 4px 10px rgba(79,70,229,.25); }
        .parent-main {
            width: calc(100% - 260px);
            margin-left: 260px;
            min-width: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        .parent-topbar { flex-shrink: 0; background: #fff; border-bottom: 1px solid #e2e8f0; padding: .85rem 1.5rem; }
        .parent-content { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
        .parent-footer { flex-shrink: 0; }
        @@media (max-width: 991.98px) {
            #parentSidebar { margin-left: -260px; position: fixed; inset: 0 auto 0 0; height: 100vh; }
            #parentSidebar.show { margin-left: 0; box-shadow: 0 0 20px rgba(0,0,0,.15); }
            .parent-main { width: 100%; margin-left: 0; }
        }
    </style>
</head>
<body>
    <div class="d-flex min-vh-100">
        <nav id="parentSidebar" class="d-flex flex-column">
            <div class="parent-brand d-flex align-items-center justify-content-between">
                <a asp-controller="ParentDashboard" asp-action="Index" class="text-decoration-none d-flex align-items-center">
                    <div class="bg-primary text-white rounded-3 p-2 me-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px"><i class="bi bi-mortarboard-fill fs-5"></i></div>
                    <div><div class="fw-bold text-dark fs-5 lh-1">EduCenter</div><span class="badge bg-primary-subtle text-primary border mt-1" style="font-size:.7rem">Parent Portal</span></div>
                </a>
                <button type="button" class="btn-close d-lg-none" id="parentSidebarClose" aria-label="Đóng"></button>
            </div>

            <div class="px-3 py-3 mx-2 my-2 bg-light rounded-3 d-flex align-items-center">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width:40px;height:40px"><i class="bi bi-people-fill fs-5"></i></div>
                <div class="overflow-hidden"><div class="fw-bold text-dark text-truncate small">@(User.Identity?.Name ?? "Phụ huynh")</div><div class="text-success small"><i class="bi bi-circle-fill me-1" style="font-size:.4rem"></i>Đang trực tuyến</div></div>
            </div>

            <div class="parent-menu flex-grow-1 overflow-auto py-2">
                <div class="px-3 mb-2 text-uppercase text-muted fw-bold" style="font-size:.72rem;letter-spacing:.5px">Quản lý gia đình</div>
                <ul class="nav flex-column">
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ParentDashboard" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="ParentDashboard" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Tổng quan</span></a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Enrollment" ? "active" : "")" asp-controller="Enrollment" asp-action="Index"><i class="bi bi-journal-plus"></i><span>Đăng ký lớp học</span></a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ParentAcademic" || ViewContext.RouteData.Values["action"]?.ToString() == "AcademicTracking" ? "active" : "")" asp-controller="ParentDashboard" asp-action="AcademicTracking"><i class="bi bi-graph-up-arrow"></i><span>Theo dõi học tập</span></a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Links" ? "active" : "")" asp-controller="ParentDashboard" asp-action="Links"><i class="bi bi-link-45deg"></i><span>Liên kết học sinh</span></a></li>
                </ul>
            </div>

            <div class="p-3 border-top bg-light">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2"><i class="bi bi-house-door me-2"></i>Về trang chủ</a>
                <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger btn-sm w-100"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form>
            </div>
        </nav>

        <div class="parent-main">
            <header class="parent-topbar d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center"><button class="btn btn-light border d-lg-none me-2" id="parentSidebarToggle" type="button"><i class="bi bi-list fs-5"></i></button><span class="text-secondary small d-none d-sm-inline"><i class="bi bi-shield-check text-success me-1"></i>Khu vực dành cho Phụ huynh</span></div>
                <span class="badge bg-light text-dark border px-3 py-2"><i class="bi bi-person-circle text-primary me-1"></i>@User.Identity?.Name</span>
            </header>
            <main class="parent-content p-3 p-md-4">@RenderBody()</main>
            <footer class="parent-footer py-3 px-4 bg-white border-top text-muted small">&copy; 2026 - EduCenterManagement - Cổng thông tin Phụ huynh</footer>
        </div>
    </div>

    <div id="parentSidebarBackdrop" class="d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50" style="z-index:1030"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const parentSidebar = document.getElementById('parentSidebar');
        const parentBackdrop = document.getElementById('parentSidebarBackdrop');
        const toggleParentSidebar = () => { parentSidebar.classList.toggle('show'); parentBackdrop.classList.toggle('d-none'); };
        document.getElementById('parentSidebarToggle')?.addEventListener('click', toggleParentSidebar);
        document.getElementById('parentSidebarClose')?.addEventListener('click', toggleParentSidebar);
        parentBackdrop?.addEventListener('click', toggleParentSidebar);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
