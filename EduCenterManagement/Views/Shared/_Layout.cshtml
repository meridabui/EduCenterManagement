<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduCenterManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/katex/katex.min.css" />
    <link rel="stylesheet" href="~/EduCenterManagement.styles.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideNavbar"] as bool? != true)
    {
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-1"></i>EduCenter
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="StudentTimetable" asp-action="Index">
                                    <i class="bi bi-calendar3 me-1"></i>Thời khóa biểu
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="StudentQuiz" asp-action="Index">
                                    <i class="bi bi-ui-checks me-1"></i>Bài Quiz
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="StudentComment" asp-action="Index">
                                    <i class="bi bi-chat-left-text me-1"></i>Nhận xét
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="StudentDashboard" asp-action="Index">
                                    <i class="bi bi-person-badge me-1"></i>Liên kết phụ huynh
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Parent"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="ParentDashboard" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Trang phụ huynh
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-2">
                                <span class="nav-link text-muted small">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                    @if (User.IsInRole("Teacher"))
                                    {
                                        <span class="badge bg-success-subtle text-success border ms-1">Giáo viên</span>
                                    }
                                    @if (User.IsInRole("Student"))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border ms-1">Học sinh</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#" data-bs-toggle="modal" data-bs-target="#layoutLoginModal">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-2" href="#" data-bs-toggle="modal" data-bs-target="#layoutRegisterModal">
                                    Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EduCenterManagement - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    @if (ViewData["HideNavbar"] as bool? != true && User.Identity?.IsAuthenticated != true)
    {
        @* Popup Đăng nhập / Đăng ký: cùng giao diện và logic với Home/Index *@
        <style>
            .ed-auth-modal .modal-content { border: 0; border-radius: 20px; overflow: hidden; box-shadow: 0 25px 80px rgba(15,23,42,.2); }
            .ed-modal-heading { background: linear-gradient(135deg, #eef2ff, #ecfdf5); padding: 25px 25px 18px; }
            .ed-modal-body { padding: 25px; }
            .ed-auth-modal .ed-brand { color: #4338ca; font-weight: 800; letter-spacing: -.6px; font-size: 1.35rem; }
            .ed-auth-modal .ed-btn-primary { background: #4338ca; border-color: #4338ca; color: white; border-radius: 10px; font-weight: 600; padding: .7rem 1.15rem; }
            .ed-auth-modal .ed-btn-primary:hover { background: #312e81; border-color: #312e81; color: white; }
            .ed-auth-modal .ed-form-control { border-radius: 10px; padding: .75rem .9rem; }
            .ed-auth-modal .ed-form-control:focus { border-color: #818cf8; box-shadow: 0 0 0 .2rem rgba(99,102,241,.13); }
            .ed-auth-modal .ed-link { color: #4338ca; cursor: pointer; font-weight: 700; text-decoration: none; }
            .ed-auth-modal .ed-soft-label { color: #475569; font-size: .9rem; font-weight: 600; margin-bottom: 7px; }
            .ed-auth-modal .ed-feature-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; margin-bottom: 18px; }
            .ed-hidden { display: none !important; }
        </style>

        <!-- LOGIN MODAL -->
        <div class="modal fade ed-auth-modal" id="layoutLoginModal" tabindex="-1" aria-labelledby="layoutLoginTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="ed-modal-heading">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="ed-brand mb-2">EduCenter</div>
                                <h2 id="layoutLoginTitle" class="h4 fw-bold mb-1">Chào mừng trở lại</h2>
                                <p class="text-secondary small mb-0">Đăng nhập vào tài khoản của bạn.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>
                    </div>

                    <div class="ed-modal-body">
                        <form id="layoutLoginForm" asp-area="" asp-controller="Account" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <div id="layoutLoginError" class="alert alert-danger ed-hidden" role="alert"></div>


                            <div class="mb-3">
                                <label for="layoutLoginEmail" class="ed-soft-label">Email</label>
                                <input id="layoutLoginEmail" name="Email" type="email"
                                       class="form-control ed-form-control"
                                       autocomplete="username" required />
                            </div>

                            <div class="mb-3">
                                <label for="layoutLoginPassword" class="ed-soft-label">Mật khẩu</label>
                                <input id="layoutLoginPassword" name="Password" type="password"
                                       class="form-control ed-form-control"
                                       autocomplete="current-password" required />
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox"
                                       id="layoutLoginRemember" name="RememberMe" value="true" />
                                <label class="form-check-label small" for="layoutLoginRemember">
                                    Ghi nhớ đăng nhập
                                </label>
                            </div>

                            <button id="layoutLoginSubmit" type="submit" class="btn ed-btn-primary w-100">
                                Đăng nhập
                            </button>
                        </form>

                        <div class="text-center small mt-4">
                            Chưa có tài khoản?
                            <a href="#" class="ed-link" data-layout-open-register>Đăng ký ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- REGISTER MODAL -->
        <div class="modal fade ed-auth-modal" id="layoutRegisterModal" tabindex="-1" aria-labelledby="layoutRegisterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="ed-modal-heading">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="ed-brand mb-2">EduCenter</div>
                                <h2 id="layoutRegisterTitle" class="h4 fw-bold mb-1">Tạo tài khoản</h2>
                                <p class="text-secondary small mb-0">Chọn vai trò để bắt đầu.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>
                    </div>

                    <div class="ed-modal-body">
                        <ul class="nav nav-pills nav-fill gap-2 mb-4">
                            <li class="nav-item">
                                <button class="nav-link active" type="button" data-layout-register-role="Parent">Phụ huynh</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" type="button" data-layout-register-role="Student">Học sinh</button>
                            </li>
                        </ul>

                        <form id="layoutRegisterForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="layoutRegisterRole" value="Parent" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="layoutRegisterFullName" class="ed-soft-label">Họ và tên</label>
                                    <input id="layoutRegisterFullName" class="form-control ed-form-control"
                                           maxlength="100" required />
                                </div>

                                <div class="col-md-6">
                                    <label for="layoutRegisterEmail" class="ed-soft-label">Email</label>
                                    <input id="layoutRegisterEmail" type="email"
                                           class="form-control ed-form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label for="layoutRegisterPassword" class="ed-soft-label">Mật khẩu</label>
                                    <input id="layoutRegisterPassword" type="password"
                                           minlength="8" autocomplete="new-password"
                                           class="form-control ed-form-control" required />
                                </div>
                            </div>

                            <div id="layoutRegisterError" class="alert alert-danger ed-hidden mt-3"></div>

                            <button type="submit" class="btn ed-btn-primary w-100 mt-4">
                                Tạo tài khoản
                            </button>
                        </form>

                        <div class="text-center small mt-4">
                            Đã có tài khoản?
                            <a href="#" class="ed-link" data-layout-open-login>Đăng nhập</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <partial name="_VerifyCodeModal" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (ViewData["HideNavbar"] as bool? != true && User.Identity?.IsAuthenticated != true)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const loginModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("layoutLoginModal"));
                const registerModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("layoutRegisterModal"));

                const loginForm = document.getElementById("layoutLoginForm");
                const loginError = document.getElementById("layoutLoginError");
                const loginSubmit = document.getElementById("layoutLoginSubmit");

                const registerForm = document.getElementById("layoutRegisterForm");
                const registerError = document.getElementById("layoutRegisterError");
                const registerRole = document.getElementById("layoutRegisterRole");

                // Chuyển đổi giữa các modal.
                document.querySelectorAll("[data-layout-open-register]").forEach(function (link) {
                    link.addEventListener("click", function (event) {
                        event.preventDefault();
                        loginModal.hide();
                        setTimeout(() => registerModal.show(), 180);
                    });
                });

                document.querySelectorAll("[data-layout-open-login]").forEach(function (link) {
                    link.addEventListener("click", function (event) {
                        event.preventDefault();
                        registerModal.hide();
                        setTimeout(() => loginModal.show(), 180);
                    });
                });

                // Tab đăng ký Parent / Student.
                document.querySelectorAll("[data-layout-register-role]").forEach(function (button) {
                    button.addEventListener("click", function () {
                        document.querySelectorAll("[data-layout-register-role]").forEach(function (tab) {
                            tab.classList.remove("active");
                        });
                        button.classList.add("active");
                        registerRole.value = button.dataset.layoutRegisterRole;
                        registerError.classList.add("ed-hidden");
                    });
                });

                // Đăng nhập: gọi POST Account/Login (trả JSON khi gửi bằng AJAX).
                loginForm.addEventListener("submit", async function (event) {
                    event.preventDefault();

                    loginError.classList.add("ed-hidden");
                    loginSubmit.disabled = true;
                    loginSubmit.textContent = "Đang đăng nhập...";

                    try {
                        const response = await fetch(loginForm.action, {
                            method: "POST",
                            body: new URLSearchParams(new FormData(loginForm)),
                            credentials: "same-origin",
                            headers: {
                                "Accept": "application/json",
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        });

                        const result = await response.json();

                        if (!response.ok || !result.success) {
                            if (result.needsVerification) {
                                const emailValue = document.getElementById("layoutLoginEmail").value.trim();
                                loginModal.hide();
                                setTimeout(() => window.openVerifyCodeModal(emailValue), 180);
                                return;
                            }
                            loginError.textContent = result.message || "Đăng nhập không thành công.";
                            loginError.classList.remove("ed-hidden");
                            return;
                        }

                        // Đăng nhập thành công: chuyển tới trang làm việc theo vai trò.
                        window.location.href = result.portalUrl || window.location.href;
                    } catch (error) {
                        console.error("Login request failed:", error);
                        loginError.textContent =
                            "Không gửi được yêu cầu đến máy chủ. Vui lòng kiểm tra ứng dụng và thử lại.";
                        loginError.classList.remove("ed-hidden");
                    } finally {
                        loginSubmit.disabled = false;
                        loginSubmit.textContent = "Đăng nhập";
                    }
                });

                // Đăng ký Parent / Student: tạo tài khoản thật và gửi email xác thực.
                registerForm.addEventListener("submit", async function (event) {
                    event.preventDefault();
                    registerError.classList.add("ed-hidden");

                    const fullName = document.getElementById("layoutRegisterFullName").value.trim();
                    const email = document.getElementById("layoutRegisterEmail").value.trim();
                    const password = document.getElementById("layoutRegisterPassword").value;
                    const role = registerRole.value;

                    if (!fullName || !email || password.length < 8) {
                        registerError.textContent = "Vui lòng nhập họ tên, email và mật khẩu tối thiểu 8 ký tự.";
                        registerError.classList.remove("ed-hidden");
                        return;
                    }

                    const submitButton = registerForm.querySelector('button[type="submit"]');
                    const submitText = submitButton.textContent;
                    submitButton.disabled = true;
                    submitButton.textContent = "Đang tạo tài khoản...";

                    try {
                        const body = new URLSearchParams();
                        body.append("Role", role);
                        body.append("FullName", fullName);
                        body.append("Email", email);
                        body.append("Password", password);
                        body.append(
                            "__RequestVerificationToken",
                            registerForm.querySelector('input[name="__RequestVerificationToken"]').value);

                        const response = await fetch("@Url.Action("Register", "Account", new { area = "" })", {
                            method: "POST",
                            body: body,
                            credentials: "same-origin",
                            headers: {
                                "Accept": "application/json",
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        });

                        const result = await response.json();

                        if (!response.ok || !result.success) {
                            registerError.textContent = result.message || "Đăng ký không thành công.";
                            registerError.classList.remove("ed-hidden");
                            return;
                        }

                        registerModal.hide();
                        registerForm.reset();
                        registerRole.value = document.querySelector("[data-layout-register-role].active").dataset.layoutRegisterRole;

                        setTimeout(() => window.openVerifyCodeModal(result.email, result.message), 180);
                    } catch (error) {
                        console.error("Register request failed:", error);
                        registerError.textContent = "Không gửi được yêu cầu đến máy chủ. Vui lòng thử lại.";
                        registerError.classList.remove("ed-hidden");
                    } finally {
                        submitButton.disabled = false;
                        submitButton.textContent = submitText;
                    }
                });
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
