@model EduCenterManagement.ViewModels.Parent.ParentTimetableViewModel

@{
    ViewData["Title"] = $"Thời khóa biểu - {Model.Navigation.StudentName}";
    var previousWeek = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
}

<style>
    .parent-timetable {
        table-layout: fixed;
        width: 100%;
        min-width: 1180px;
        background: #fff;
    }

    .parent-timetable th,
    .parent-timetable td {
        border: 1px solid #dee2e6;
        padding: 8px;
        vertical-align: top;
    }

    .parent-timetable .slot-column {
        width: 125px;
        background: #f8f9fa;
        text-align: center;
        vertical-align: middle;
    }

    .parent-timetable .day-column {
        min-width: 150px;
    }

    .parent-timetable .today-header {
        background: #0d6efd !important;
        color: #fff;
    }

    .parent-timetable .today-cell {
        background: #f0f7ff;
    }

    .parent-timetable .empty-slot {
        color: #adb5bd;
        font-size: .85rem;
        font-style: italic;
        text-align: center;
        padding: 28px 4px;
    }

    .parent-timetable .session-card {
        border: 1px solid #e5e7eb;
        border-left: 4px solid #0d6efd;
        border-radius: 7px;
        background: #fff;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
        padding: 9px;
        margin-bottom: 6px;
    }

    .parent-timetable .session-card:last-child {
        margin-bottom: 0;
    }

    .parent-timetable .session-title {
        color: #0d6efd;
        font-weight: 700;
        line-height: 1.25;
    }
</style>

<div class="container-fluid py-4 px-0">
    <partial name="_ChildAcademicNav" model="Model.Navigation" />

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="studentId" value="@Model.Navigation.StudentId" />
                <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                <div class="col-md-8">
                    <label for="classId" class="form-label fw-semibold">Lọc theo lớp</label>
                    <select id="classId" name="classId" class="form-select">
                        <option value="">Tất cả các lớp</option>
                        @foreach (var item in Model.Classes)
                        {
                            <option value="@item.ClassId" selected="@(Model.SelectedClassId == item.ClassId)">@item.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Lọc lịch học
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3 bg-light">
        <div class="card-body py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a asp-action="Timetable" asp-route-studentId="@Model.Navigation.StudentId"
                   asp-route-classId="@Model.SelectedClassId" asp-route-weekStart="@previousWeek"
                   class="btn btn-sm btn-outline-dark">
                    <i class="bi bi-chevron-left"></i> Tuần trước
                </a>
                <strong class="mx-2">Tuần: @Model.WeekStart.ToString("dd/MM/yyyy") - @Model.WeekEnd.ToString("dd/MM/yyyy")</strong>
                <a asp-action="Timetable" asp-route-studentId="@Model.Navigation.StudentId"
                   asp-route-classId="@Model.SelectedClassId" asp-route-weekStart="@nextWeek"
                   class="btn btn-sm btn-outline-dark">
                    Tuần sau <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <a asp-action="Timetable" asp-route-studentId="@Model.Navigation.StudentId"
               asp-route-classId="@Model.SelectedClassId" class="btn btn-sm btn-primary">
                <i class="bi bi-calendar-event me-1"></i>Hôm nay
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="parent-timetable mb-0">
                <thead>
                    <tr class="text-center align-middle">
                        <th class="slot-column py-3">Ca học</th>
                        @foreach (var day in Model.Days)
                        {
                            <th class="day-column py-3 @(day.IsToday ? "today-header" : "bg-light")">
                                <div class="fw-bold">@day.DayName</div>
                                <div class="small @(day.IsToday ? "text-white" : "text-muted")">(@day.Date.ToString("dd/MM"))</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TimeSlots.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                Trung tâm chưa cấu hình ca học.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var slot in Model.TimeSlots)
                        {
                            <tr>
                                <td class="slot-column">
                                    <div class="fw-bold text-primary">@slot.Name</div>
                                    <div class="text-muted small">@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</div>
                                </td>

                                @foreach (var day in Model.Days)
                                {
                                    var cellSessions = day.Sessions.Where(session =>
                                        session.TimeSlotId == slot.TimeSlotId
                                        || (session.StartsAt >= slot.StartTime && session.StartsAt < slot.EndTime))
                                        .ToList();

                                    <td class="@(day.IsToday ? "today-cell" : "")">
                                        @if (cellSessions.Count == 0)
                                        {
                                            <div class="empty-slot">(Trống)</div>
                                        }
                                        else
                                        {
                                            @foreach (var session in cellSessions)
                                            {
                                                <div class="session-card">
                                                    <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                                        <div class="session-title" title="@session.ClassName">
                                                            [@session.SubjectName - @session.ClassName]
                                                        </div>
                                                        <span class="badge bg-@session.StatusCssClass">@session.StatusText</span>
                                                    </div>
                                                    <div class="small mb-1"><strong>GV:</strong> @session.TeacherName</div>
                                                    <div class="small text-muted">Buổi @session.SessionNumber</div>
                                                    @if (session.StartsAt != slot.StartTime || session.EndsAt != slot.EndTime)
                                                    {
                                                        <div class="small text-muted">
                                                            <i class="bi bi-clock me-1"></i>@session.StartsAt.ToString("HH:mm") - @session.EndsAt.ToString("HH:mm")
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
