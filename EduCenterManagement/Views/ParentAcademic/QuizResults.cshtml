@model EduCenterManagement.ViewModels.Parent.ParentQuizResultsViewModel

@{
    ViewData["Title"] = $"Điểm Quiz - {Model.Navigation.StudentName}";
}

<div class="container-fluid py-4 px-0">
    <partial name="_ChildAcademicNav" model="Model.Navigation" />

    <div class="alert alert-info small">
        <i class="bi bi-shield-check me-1"></i>Phụ huynh chỉ xem điểm và trạng thái bài làm; nội dung câu hỏi và đáp án không được hiển thị.
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="studentId" value="@Model.Navigation.StudentId" />
                <div class="col-md-8">
                    <label for="classId" class="form-label fw-semibold">Lọc theo lớp</label>
                    <select id="classId" name="classId" class="form-select">
                        <option value="">Tất cả các lớp</option>
                        @foreach (var item in Model.Classes)
                        {
                            <option value="@item.ClassId" selected="@(Model.SelectedClassId == item.ClassId)">@item.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-4"><button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc kết quả</button></div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3"><h5 class="mb-0">Kết quả Quiz</h5></div>
        <div class="card-body p-0">
            @if (Model.Attempts.Count == 0)
            {
                <div class="p-4 text-muted">Chưa có bài Quiz nào đã hoàn thành.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Bài Quiz</th><th>Lớp/Môn</th><th>Lần làm</th><th>Điểm</th><th>Tỷ lệ</th><th>Trạng thái</th><th>Hoàn thành</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Attempts)
                            {
                                var scoreClass = item.Percentage >= 80 ? "success" : item.Percentage >= 50 ? "warning" : "danger";
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.QuizTitle</div>
                                        @if (item.IsBestAttempt)
                                        {
                                            <span class="badge bg-success-subtle text-success border">Điểm cao nhất</span>
                                        }
                                    </td>
                                    <td><div>@item.ClassName</div><div class="text-muted small">@item.SubjectName</div></td>
                                    <td>@item.AttemptNumber</td>
                                    <td class="fw-bold text-@scoreClass">@item.Score.ToString("0.##")/@item.TotalPoints.ToString("0.##")</td>
                                    <td>@item.Percentage.ToString("0.#")%</td>
                                    <td>@item.StatusText</td>
                                    <td>@(item.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
