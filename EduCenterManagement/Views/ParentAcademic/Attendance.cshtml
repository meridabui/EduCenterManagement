@model EduCenterManagement.ViewModels.Parent.ParentAttendanceViewModel

@{
    ViewData["Title"] = $"Điểm danh - {Model.Navigation.StudentName}";
}

<div class="container-fluid py-4 px-0">
    <partial name="_ChildAcademicNav" model="Model.Navigation" />

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="studentId" value="@Model.Navigation.StudentId" />
                <div class="col-md-8">
                    <label for="classId" class="form-label fw-semibold">Lọc theo lớp</label>
                    <select id="classId" name="classId" class="form-select">
                        <option value="">Tất cả các lớp</option>
                        @foreach (var item in Model.Classes)
                        {
                            <option value="@item.ClassId" selected="@(Model.SelectedClassId == item.ClassId)">@item.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Lọc điểm danh
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Tổng buổi</div><div class="fs-3 fw-bold">@Model.TotalSessions</div></div></div></div>
        <div class="col-6 col-lg"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-success small">Có mặt</div><div class="fs-3 fw-bold text-success">@Model.PresentCount</div></div></div></div>
        <div class="col-6 col-lg"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-danger small">Vắng mặt</div><div class="fs-3 fw-bold text-danger">@Model.AbsentCount</div></div></div></div>
        <div class="col-12 col-lg"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-primary small">Chuyên cần</div><div class="fs-3 fw-bold text-primary">@Model.AttendanceRate.ToString("0.#")%</div></div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3"><h5 class="mb-0">Lịch sử điểm danh</h5></div>
        <div class="card-body p-0">
            @if (Model.Items.Count == 0)
            {
                <div class="p-4 text-muted">Chưa có buổi học nào đã đến giờ.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Ngày học</th><th>Lớp/Môn</th><th>Buổi</th><th>Thời gian</th><th>Trạng thái</th><th>Ghi chú</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.SessionDate.ToString("dd/MM/yyyy")</td>
                                    <td><div class="fw-semibold">@item.ClassName</div><div class="text-muted small">@item.SubjectName</div></td>
                                    <td>@item.SessionNumber</td>
                                    <td>@item.StartsAt.ToString("HH:mm")–@item.EndsAt.ToString("HH:mm")</td>
                                    <td><span class="badge bg-@item.StatusCssClass">@item.StatusText</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Note) ? "—" : item.Note)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
