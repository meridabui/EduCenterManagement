@model IReadOnlyList<EduCenterManagement.ViewModels.TeacherComment.TeacherStudentViewModel>
@{var userId=Context.Request.Query["userId"].ToString();var classId=Context.Request.Query["classId"].ToString();}<h1>Students</h1>@if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}@if(!Model.Any()){<p class="text-muted">No confirmed students.</p>}else{<table class="table"><thead><tr><th>Student</th><th>Comments</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Name</td><td>@s.CommentCount</td><td><a class="btn btn-sm btn-primary" asp-action="Create" asp-route-classId="@classId" asp-route-studentId="@s.Id" asp-route-userId="@userId">Write comment</a> <a class="btn btn-sm btn-outline-secondary" asp-action="History" asp-route-classId="@classId" asp-route-studentId="@s.Id" asp-route-userId="@userId">History</a></td></tr>}</tbody></table>}
