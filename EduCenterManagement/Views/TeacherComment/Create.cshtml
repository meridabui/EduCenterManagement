@model EduCenterManagement.ViewModels.TeacherComment.TeacherCommentFormViewModel
@{var userId=Context.Request.Query["userId"].ToString();}<h1>Write Comment</h1><form asp-action="Create" method="post"><input type="hidden" asp-for="ClassId"/><input type="hidden" asp-for="StudentId"/><div class="mb-3"><label>Rating</label><div>@for(var i=1;i<=5;i++){<label class="me-2"><input type="radio" asp-for="Rating" value="@i"/> @i ★</label>}</div><span asp-validation-for="Rating" class="text-danger"></span></div><div class="mb-3"><label asp-for="SessionId">Session</label><select asp-for="SessionId" class="form-select"><option value="">Whole class</option>@foreach(var s in Model.Sessions){<option value="@s.Id">@s.Name</option>}</select></div><div class="mb-3"><label asp-for="Content"></label><textarea asp-for="Content" class="form-control" maxlength="2000" rows="5"></textarea><span asp-validation-for="Content" class="text-danger"></span></div><button class="btn btn-primary">Save</button><a class="btn btn-secondary" asp-action="Students" asp-route-classId="@Model.ClassId" asp-route-userId="@userId">Cancel</a></form>

@section Scripts{<partial name="_ValidationScriptsPartial"/>}
