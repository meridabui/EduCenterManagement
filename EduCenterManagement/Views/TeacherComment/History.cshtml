@model IReadOnlyList<EduCenterManagement.ViewModels.TeacherComment.TeacherCommentHistoryItemViewModel>
@{var userId=Context.Request.Query["userId"].ToString();var classId=Context.Request.Query["classId"].ToString();var studentId=Context.Request.Query["studentId"].ToString();var zone=TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");}<h1>Comment History</h1>@if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}@if(!Model.Any()){<p class="text-muted">No comments yet.</p>}else{foreach(var c in Model){var date=TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(c.CreatedAt,DateTimeKind.Utc),zone);<article class="card mb-3"><div class="card-body"><strong class="text-warning">@string.Concat(Enumerable.Repeat("★",c.Rating))</strong><p style="white-space:pre-line">@c.Content</p><small>Session @(c.SessionNumber?.ToString()??"Whole class") · @date.ToString("dd MMM yyyy HH:mm")</small><div class="mt-2"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id" asp-route-classId="@classId" asp-route-studentId="@studentId" asp-route-userId="@userId">Edit</a><form class="d-inline" asp-action="Delete" method="post" onsubmit="return confirm('Delete this comment?');"><input type="hidden" name="id" value="@c.Id"/><input type="hidden" name="classId" value="@classId"/><input type="hidden" name="studentId" value="@studentId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></article>}}
