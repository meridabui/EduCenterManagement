@using EduCenterManagement.Enums
@using EduCenterManagement.ViewModels.Student
@model QuizAttemptHistoryViewModel

@{
    ViewData["Title"] = $"Các lượt làm - {Model.Title}";
}

<div class="container mt-4 mb-5" style="max-width: 860px;">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Danh sách bài quiz
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold mb-1">@Model.Title</h4>
                <div class="text-muted small">@Model.ClassName · Đã làm @Model.Attempts.Count / @Model.MaxAttempts lượt</div>
            </div>
            <div class="text-md-end">
                @if (Model.CanRetake)
                {
                    <form asp-action="Start" asp-route-id="@Model.QuizId" method="post" class="mt-1"
                          onsubmit="return confirm('Bắt đầu lượt làm mới?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-arrow-repeat me-1"></i>Làm lại
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    @if (!Model.Attempts.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                Bạn chưa làm lượt nào cho bài quiz này.
            </div>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var a in Model.Attempts)
            {
                var (statusClass, statusText) = a.Status switch
                {
                    QuizAttemptStatus.InProgress => ("bg-warning text-dark", "Đang làm dở"),
                    QuizAttemptStatus.Submitted => ("bg-success", "Đã nộp"),
                    QuizAttemptStatus.AutoSubmitted => ("bg-info text-dark", "Tự động nộp"),
                    QuizAttemptStatus.Expired => ("bg-secondary", "Quá hạn"),
                    _ => ("bg-secondary", a.Status.ToString())
                };
                var href = a.IsInProgress
                    ? Url.Action("Take", new { id = a.AttemptId })
                    : Url.Action("Result", new { id = a.AttemptId });

                <a href="@href"
                   class="list-group-item list-group-item-action d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div>
                        <div class="fw-semibold">
                            Lượt @a.AttemptNumber
                            <span class="badge @statusClass ms-1">@statusText</span>
                        </div>
                        <div class="text-muted small">
                            Bắt đầu: @a.StartedAt.ToString("dd/MM/yyyy HH:mm")
                            @if (a.SubmittedAt.HasValue)
                            {
                                <span> · Nộp: @a.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        @if (a.Score.HasValue)
                        {
                            <span class="fs-5 fw-bold">@a.Score.Value.ToString("0.##")</span>
                            <span class="text-muted">/ @Model.TotalPoints.ToString("0.##")</span>
                        }
                        else
                        {
                            <span class="text-warning fw-semibold"><i class="bi bi-play-fill"></i> Tiếp tục làm</span>
                        }
                        <i class="bi bi-chevron-right ms-2 text-muted"></i>
                    </div>
                </a>
            }
        </div>
    }
</div>
