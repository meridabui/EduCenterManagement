@model EduCenterManagement.ViewModels.ParentChildren.CommentsPageViewModel
@{var userId=Context.Request.Query["userId"].ToString();var zone=TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");}
<h1>@Model.StudentName - Teacher Comments</h1><partial name="_ChildNav" model="Model.StudentId" />
<form method="get" class="row g-2 mb-3"><input type="hidden" name="studentId" value="@Model.StudentId"/><input type="hidden" name="userId" value="@userId"/><div class="col-auto"><select name="classId" class="form-select"><option value="">All classes</option>@foreach(var c in Model.Classes){<option value="@c.Id" selected="@(c.Id==Model.ClassId)">@c.Name</option>}</select></div><div class="col-auto"><button class="btn btn-primary">Filter</button></div></form>
@if(!Model.Items.Any()){<p class="text-muted">No teacher comments yet.</p>}else{foreach(var item in Model.Items){var date=TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(item.CreatedAt,DateTimeKind.Utc),zone);<article class="card mb-3"><div class="card-body"><h5>@item.TeacherName <span class="text-warning">@string.Concat(Enumerable.Repeat("★",item.Rating))</span></h5><p class="text-muted">@item.SubjectName / @item.ClassName@if(item.SessionNumber.HasValue){<text> · Session @item.SessionNumber</text>} · @date.ToString("dd MMM yyyy HH:mm")</p><p style="white-space:pre-line">@item.Content</p></div></article>}<nav>@for(var i=1;i<=Model.TotalPages;i++){<a class="btn btn-sm @(i==Model.Page?"btn-primary":"btn-outline-primary")" asp-route-studentId="@Model.StudentId" asp-route-classId="@Model.ClassId" asp-route-page="@i" asp-route-userId="@userId">@i</a>}</nav>}
