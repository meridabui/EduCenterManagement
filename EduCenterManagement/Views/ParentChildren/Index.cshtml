@model EduCenterManagement.ViewModels.ParentChildren.ParentChildrenViewModel
<h1>My Children</h1><p>Your Parent Linking Code: <strong>@Model.LinkingCode</strong> @if(Model.PendingCount>0){<span class="badge bg-warning">@Model.PendingCount pending</span>}</p>@if(!Model.Children.Any()){<p>Share your Parent Linking Code with your child so they can send a link request.</p>}else{<div class="list-group">@foreach(var c in Model.Children){<a class="list-group-item" asp-action="Details" asp-route-studentId="@c.Id">@c.Name <span class="text-muted">(@c.ClassCount confirmed classes)</span></a>}</div>}
