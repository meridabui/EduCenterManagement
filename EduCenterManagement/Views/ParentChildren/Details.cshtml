@model EduCenterManagement.ViewModels.ParentChildren.ChildDetailsViewModel
<h1>@Model.Name</h1><partial name="_ChildNav" model="Model.Id" /><table class="table"><thead><tr><th>Subject</th><th>Class</th><th>Teacher</th><th>Schedule</th><th>Dates</th><th>Status</th></tr></thead><tbody>@foreach(var c in Model.Classes){<tr><td>@c.Subject</td><td>@c.Name</td><td>@c.Teacher</td><td>@c.Schedule</td><td>@c.StartDate - @c.EndDate</td><td>@c.Status</td></tr>}</tbody></table>
