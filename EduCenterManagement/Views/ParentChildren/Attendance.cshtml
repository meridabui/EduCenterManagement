@model EduCenterManagement.ViewModels.ParentChildren.AttendancePageViewModel
@{ViewData["Title"]="Attendance";var userId=Context.Request.Query["userId"].ToString();}
<h1>@Model.StudentName - Attendance</h1><partial name="_ChildNav" model="Model.StudentId" />
<form method="get" class="row g-2 mb-3"><input type="hidden" name="studentId" value="@Model.StudentId"/><input type="hidden" name="userId" value="@userId"/><div class="col-auto"><select class="form-select" name="classId"><option value="">All classes</option>@foreach(var c in Model.Classes){<option value="@c.Id" selected="@(Model.ClassId==c.Id)">@c.Name</option>}</select></div><div class="col-auto"><button class="btn btn-primary">Filter</button></div></form>
<div class="row mb-3"><div class="col">Present: <strong>@Model.Present</strong></div><div class="col">Absent: <strong>@Model.Absent</strong></div><div class="col">Attendance rate: <strong>@Model.AttendanceRate%</strong></div></div>
@if(!Model.Items.Any()){<p class="text-muted">No attendance records yet.</p>}else{<table class="table"><thead><tr><th>Date</th><th>Subject / Class</th><th>Session</th><th>Status</th><th>Note</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Date</td><td>@x.Subject / @x.ClassName</td><td>@x.SessionNumber</td><td><span class="badge @(x.Status=="Present"?"bg-success":"bg-danger")">@x.Status</span></td><td>@x.Note</td></tr>}</tbody></table><nav>@for(var i=1;i<=Model.TotalPages;i++){<a class="btn btn-sm @(i==Model.Page?"btn-primary":"btn-outline-primary")" asp-route-studentId="@Model.StudentId" asp-route-classId="@Model.ClassId" asp-route-page="@i" asp-route-userId="@userId">@i</a>}</nav>}
