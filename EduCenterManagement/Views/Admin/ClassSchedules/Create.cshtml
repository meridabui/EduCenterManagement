@model EduCenterManagement.ViewModels.Admin.ClassScheduleViewModel

@{
    ViewData["Title"] = "Thêm lịch học";
}

<div class="mx-auto" style="max-width: 760px;">
    <h1 class="h3 fw-bold mb-2">Thiết lập lịch học</h1>
    <p class="text-muted mb-4">Chọn lớp, thứ trong tuần và khung giờ cho lịch học định kỳ.</p>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <form asp-controller="ClassSchedules"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ClassId" class="form-label fw-semibold"></label>
                    <select asp-for="ClassId"
                            asp-items="ViewBag.Classes"
                            class="form-select form-select-lg fs-6">
                        <option value="">-- Chọn lớp học --</option>
                    </select>
                    <span asp-validation-for="ClassId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DayOfWeek" class="form-label fw-semibold"></label>
                    <select asp-for="DayOfWeek"
                            asp-items="ViewBag.DaysOfWeek"
                            class="form-select form-select-lg fs-6">
                        <option value="">-- Chọn thứ trong tuần --</option>
                    </select>
                    <span asp-validation-for="DayOfWeek"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TimeSlotId" class="form-label fw-semibold"></label>
                    <select asp-for="TimeSlotId"
                            asp-items="ViewBag.TimeSlots"
                            class="form-select form-select-lg fs-6">
                        <option value="">-- Chọn khung giờ --</option>
                    </select>
                    <span asp-validation-for="TimeSlotId"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    <strong>Lưu ý:</strong>
                    Hệ thống sẽ kiểm tra lịch trùng của lớp và giáo viên
                    nếu lớp đã được phân công giáo viên.
                </div>

                <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Lưu lịch học
                    </button>

                    <a asp-controller="ClassSchedules"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
