
@model IEnumerable<EduCenterManagement.Models.ClassSchedule>

@{
    ViewData["Title"] = "Quản lý lịch học";
}

<div class="admin-management-page">
    <div class="dashboard-heading flex-wrap">
        <h1 class="h3 fw-bold mb-0">Quản lý lịch học</h1>

        <a asp-controller="ClassSchedules"
           asp-action="Create"
           class="btn btn-primary">
            + Thêm lịch học
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover dashboard-table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Lớp học</th>
                            <th>Môn học</th>
                            <th>Giáo viên</th>
                            <th>Thứ</th>
                            <th>Khung giờ</th>
                            <th>Thời gian</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var schedule in Model)
                            {
                                <tr>
                                    <td>@schedule.Id</td>
                                    <td>@schedule.Class.Name</td>
                                    <td>@schedule.Class.Subject.Name</td>

                                    <td>
                                        @(schedule.Class.Teacher?.FullName
                                            ?? "Chưa phân công")
                                    </td>

                                    <td>
                                        @(schedule.DayOfWeek switch
                                        {
                                            2 => "Thứ Hai",
                                            3 => "Thứ Ba",
                                            4 => "Thứ Tư",
                                            5 => "Thứ Năm",
                                            6 => "Thứ Sáu",
                                            7 => "Thứ Bảy",
                                            8 => "Chủ nhật",
                                            _ => "Không xác định"
                                        })
                                    </td>

                                    <td>@schedule.TimeSlot.Name</td>

                                    <td>
                                        @schedule.TimeSlot.StartTime.ToString("HH:mm")
                                        -
                                        @schedule.TimeSlot.EndTime.ToString("HH:mm")
                                    </td>

                                    <td>
                                        <a asp-controller="ClassSchedules"
                                           asp-action="Edit"
                                           asp-route-id="@schedule.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    Chưa có lịch học nào.
                                    Hãy nhấn <strong>Thêm lịch học</strong>
                                    để thiết lập lịch cho lớp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Quay lại tổng quan
    </a>
</div>
