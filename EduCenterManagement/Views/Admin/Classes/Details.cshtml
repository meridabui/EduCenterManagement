@model EduCenterManagement.Models.Class

@{
    ViewData["Title"] = "Chi tiết lớp học";
    var sessionCount = ViewBag.SessionCount is int count ? count : 0;
}

<div class="mx-auto" style="max-width: 850px;">
    <h1 class="h3 fw-bold mb-4">Chi tiết lớp học</h1>

    @foreach (var key in new[] { "SuccessMessage", "ErrorMessage" })
    {
        if (TempData[key] != null)
        {
            <div class="alert @(key == "SuccessMessage" ? "alert-success" : "alert-danger")" role="alert">@TempData[key]</div>
        }
    }

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-header bg-white border-bottom p-4 fw-bold">
            Thông tin lớp học
        </div>

        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-4">Mã lớp</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Tên lớp</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Môn học</dt>
                <dd class="col-sm-8">
                    @(Model.Subject?.Name ?? "Không xác định")
                </dd>

                <dt class="col-sm-4">Giáo viên phụ trách</dt>
                <dd class="col-sm-8">
                    @(Model.Teacher?.FullName ?? "Chưa phân công")
                </dd>

                <dt class="col-sm-4">Ngày bắt đầu</dt>
                <dd class="col-sm-8">
                    @Model.StartDate.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-4">Ngày kết thúc</dt>
                <dd class="col-sm-8">
                    @Model.EndDate.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-4">Sĩ số tối đa</dt>
                <dd class="col-sm-8">@Model.MaxStudents học viên</dd>

                <dt class="col-sm-4">Học phí</dt>
                <dd class="col-sm-8">@Model.Fee.ToString("N0") đ</dd>

                <dt class="col-sm-4">Trạng thái</dt>
                <dd class="col-sm-8">
                    @switch (Model.Status)
                    {
                        case EduCenterManagement.Enums.ClassStatus.Draft:
                            <span class="badge bg-secondary">Draft - Bản nháp</span>
                            break;

                        case EduCenterManagement.Enums.ClassStatus.Open:
                            <span class="badge bg-success">Open - Đang mở đăng ký</span>
                            break;

                        case EduCenterManagement.Enums.ClassStatus.InProgress:
                            <span class="badge bg-primary">In Progress - Đang học</span>
                            break;

                        case EduCenterManagement.Enums.ClassStatus.Completed:
                            <span class="badge bg-info">Completed - Đã hoàn thành</span>
                            break;

                        case EduCenterManagement.Enums.ClassStatus.Cancelled:
                            <span class="badge bg-danger">Cancelled - Đã hủy</span>
                            break;
                    }
                </dd>

                <dt class="col-sm-4">Số buổi học</dt>
                <dd class="col-sm-8">@sessionCount buổi</dd>

                <dt class="col-sm-4">Ngày tạo</dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">Cập nhật lần cuối</dt>
                <dd class="col-sm-8">
                    @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>
        </div>

        <div class="card-footer bg-white border-top p-4 d-flex flex-wrap gap-2">
            @if (sessionCount == 0 && Model.ClassSchedules.Any()
                && Model.Status != EduCenterManagement.Enums.ClassStatus.Cancelled
                && Model.Status != EduCenterManagement.Enums.ClassStatus.Completed)
            {
                <form asp-controller="Classes" asp-action="GenerateSessions" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary">Tạo buổi học</button>
                </form>
            }
            <a asp-controller="Classes"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Sửa lớp học
            </a>

            <a asp-controller="Classes"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>
