@model EduCenterManagement.ViewModels.Admin.ClassViewModel

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Sửa lớp học";
    var minStartDate = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).AddDays(1);
    var slots = ViewBag.TimeSlots as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var schedules = Model.Schedules ?? new List<EduCenterManagement.ViewModels.Admin.ClassScheduleInputViewModel>();
    if (schedules.Count == 0)
    {
        schedules.Add(new EduCenterManagement.ViewModels.Admin.ClassScheduleInputViewModel());
    }
}

<div class="mx-auto mb-4 adminclassedit-container">
    <h1 class="h3 fw-bold mb-4">Sửa thông tin lớp học</h1>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <form asp-controller="Classes" asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editClassForm" data-teachers-url="@Url.Action("GetTeachersBySubject", "Classes")" data-class-dates data-min-start="@minStartDate.ToString("yyyy-MM-dd")">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <p class="text-muted small">Khi đổi lịch, hệ thống cập nhật các buổi tương lai chưa có dữ liệu học tập. Các buổi đã bắt đầu, đã đổi trạng thái hoặc có điểm danh, tài liệu, quiz, nhận xét được giữ nguyên.</p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control form-control-lg fs-6" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SubjectId" class="form-label fw-semibold"></label>
                        <select asp-for="SubjectId" asp-items="ViewBag.Subjects" class="form-select form-select-lg fs-6" id="SubjectId">
                            <option value="">-- Chọn môn học --</option>
                        </select>
                        <span asp-validation-for="SubjectId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate" type="date" min="@minStartDate.ToString("yyyy-MM-dd")" class="form-control form-control-lg fs-6" required />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate" type="date" min="@minStartDate.AddDays(1).ToString("yyyy-MM-dd")" class="form-control form-control-lg fs-6" required />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MaxStudents" class="form-label fw-semibold"></label>
                        <input asp-for="MaxStudents" type="number" min="1" max="1000" class="form-control form-control-lg fs-6" />
                        <span asp-validation-for="MaxStudents" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Fee" class="form-label fw-semibold"></label>
                        <input asp-for="Fee" type="number" min="0" step="any" class="form-control form-control-lg fs-6" />
                        <span asp-validation-for="Fee" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TeacherId" class="form-label fw-semibold"></label>
                        <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-select form-select-lg fs-6" id="TeacherId">
                            <option value="">-- Chưa phân công giáo viên --</option>
                        </select>
                        <span asp-validation-for="TeacherId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <p class="form-control-plaintext">Bản nháp</p>
                        <p class="text-muted small">Lưu thông tin trước, sau đó mở đăng ký tại Chi tiết lớp học.</p>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="mb-1">Lịch học trong tuần</h5>
                        <p class="text-muted small mb-0">Mỗi thứ có thể chọn một ca học riêng.</p>
                    </div>
                    <button type="button" class="btn btn-outline-primary" id="addScheduleBtn">+ Thêm lịch</button>
                </div>

                <div asp-validation-for="Schedules" class="text-danger mb-2"></div>
                <div id="scheduleError" class="text-danger mb-2"></div>
                <div id="scheduleContainer">
                    @for (var i = 0; i < schedules.Count; i++)
                    {
                        <div class="schedule-row row g-2 align-items-end border rounded p-3 mb-2">
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Thứ trong tuần</label>
                                <select name="Schedules[@i].DayOfWeek" class="form-select day-select" required>
                                    <option value="2" selected="@(schedules[i].DayOfWeek == 2)">Thứ 2</option>
                                    <option value="3" selected="@(schedules[i].DayOfWeek == 3)">Thứ 3</option>
                                    <option value="4" selected="@(schedules[i].DayOfWeek == 4)">Thứ 4</option>
                                    <option value="5" selected="@(schedules[i].DayOfWeek == 5)">Thứ 5</option>
                                    <option value="6" selected="@(schedules[i].DayOfWeek == 6)">Thứ 6</option>
                                    <option value="7" selected="@(schedules[i].DayOfWeek == 7)">Thứ 7</option>
                                    <option value="8" selected="@(schedules[i].DayOfWeek == 8)">Chủ nhật</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Ca học</label>
                                <select name="Schedules[@i].TimeSlotId" class="form-select slot-select" required>
                                    <option value="">-- Chọn ca học --</option>
                                    @foreach (var slot in slots)
                                    {
                                        <option value="@slot.Value" selected="@(slot.Value == schedules[i].TimeSlotId.ToString())">@slot.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-danger remove-schedule w-100">Xóa</button>
                            </div>
                        </div>
                    }
                </div>

                <template id="scheduleTemplate">
                    <div class="schedule-row row g-2 align-items-end border rounded p-3 mb-2">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Thứ trong tuần</label>
                            <select class="form-select day-select" data-name="DayOfWeek" required>
                                <option value="2">Thứ 2</option><option value="3">Thứ 3</option>
                                <option value="4">Thứ 4</option><option value="5">Thứ 5</option>
                                <option value="6">Thứ 6</option><option value="7">Thứ 7</option>
                                <option value="8">Chủ nhật</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Ca học</label>
                            <select class="form-select slot-select" data-name="TimeSlotId" required>
                                <option value="">-- Chọn ca học --</option>
                                @foreach (var slot in slots)
                                {
                                    <option value="@slot.Value">@slot.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2"><button type="button" class="btn btn-outline-danger remove-schedule w-100">Xóa</button></div>
                    </div>
                </template>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-controller="Classes" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
