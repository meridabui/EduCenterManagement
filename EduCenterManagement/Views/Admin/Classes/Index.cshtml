@model IEnumerable<EduCenterManagement.Models.Class>

@{
    ViewData["Title"] = "Quản lý lớp học";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý lớp học</h2>

        <a asp-controller="Classes"
           asp-action="Create"
           class="btn btn-primary">
            + Thêm lớp học
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên lớp</th>
                            <th>Subject</th>
                            <th>Teacher</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                            <th>Học phí</th>
                            <th>Sĩ số tối đa</th>
                            <th>Trạng thái</th>
                            <th style="min-width: 250px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td>@item.Subject.Name</td>

                                    <td>
                                        @(item.Teacher?.FullName ?? "Chưa phân công")
                                    </td>

                                    <td>
                                        @item.StartDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.EndDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.Fee.ToString("N0") đ
                                    </td>

                                    <td>@item.MaxStudents</td>

                                    <td>
                                        @switch (item.Status)
                                        {
                                            case EduCenterManagement.Enums.ClassStatus.Draft:
                                                <span class="badge bg-secondary">Draft</span>
                                                break;

                                            case EduCenterManagement.Enums.ClassStatus.Open:
                                                <span class="badge bg-success">Open</span>
                                                break;

                                            case EduCenterManagement.Enums.ClassStatus.InProgress:
                                                <span class="badge bg-primary">In Progress</span>
                                                break;

                                            case EduCenterManagement.Enums.ClassStatus.Completed:
                                                <span class="badge bg-info">Completed</span>
                                                break;

                                            case EduCenterManagement.Enums.ClassStatus.Cancelled:
                                                <span class="badge bg-danger">Cancelled</span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Classes"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info mb-1">
                                            Chi tiết
                                        </a>

                                        <a asp-controller="Classes"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning mb-1">
                                            Sửa
                                        </a>

                                        @if (item.Status !=
                                            EduCenterManagement.Enums.ClassStatus.Cancelled)
                                        {
                                            <a asp-controller="Classes"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-danger mb-1">
                                                Ngừng sử dụng
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4">
                                    Chưa có lớp học nào.
                                    Hãy nhấn <strong>Thêm lớp học</strong>
                                    để tạo mới.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Quay lại Dashboard
    </a>
</div>
