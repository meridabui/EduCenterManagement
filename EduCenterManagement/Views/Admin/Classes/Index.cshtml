@model IEnumerable<EduCenterManagement.Models.Class>

@using Microsoft.AspNetCore.Mvc.Rendering
@using EduCenterManagement.Enums

@{
    ViewData["Title"] = "Quản lý lớp học";
    ViewData["BodyClass"] = "admin-class-index";
    var minStartDate = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).AddDays(1);
    var pagination = (EduCenterManagement.ViewModels.Admin.PaginationViewModel)ViewBag.Pagination;
    var rowNumber = pagination.Offset;
    var subjects = ViewBag.Subjects as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var timeSlots = ViewBag.TimeSlots as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var teachers = ViewBag.Teachers as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var openCreateModal = ViewBag.OpenCreateModal is bool open && open;
    var filterSubjects = ViewBag.FilterSubjects as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var filterTeachers = ViewBag.FilterTeachers as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var filterStatuses = ViewBag.FilterStatuses as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var hasFilters = ViewBag.HasClassFilters is bool filtered && filtered;
}

<div class="class-page"
     data-teachers-url="@Url.Action("GetTeachersBySubject", "Classes")"
     data-conflict-url="@Url.Action("CheckConflict", "Classes")"
     data-assign-info-url="@Url.Action("AssignInfo", "Classes")"
     data-capacity-url="@Url.Action("Capacity", "Classes")"
     data-open-create="@(openCreateModal ? "true" : "false")">
    <div class="class-header">
        <div>
            <h1>Quản lý lớp học</h1>
            <p>Tạo lớp, thiết lập lịch học theo từng thứ và phân công giáo viên</p>
        </div>
        <button type="button" class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#createClassModal">
            <span class="me-1">＋</span> Mở lớp học mới
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <form asp-controller="Classes" asp-action="Index" method="get" class="dashboard-panel mb-4" aria-label="Lọc danh sách lớp học">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-xl-3">
                <label for="filterSubjectId" class="form-label fw-semibold">Môn học</label>
                <select id="filterSubjectId" name="subjectId" asp-items="filterSubjects" class="form-select"
                        aria-describedby="filterSubjectHelp">
                    <option value="">Tất cả môn học</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label for="filterTeacherId" class="form-label fw-semibold">Giáo viên</label>
                <select id="filterTeacherId" name="teacherId" asp-items="filterTeachers" class="form-select">
                    <option value="">Tất cả giáo viên</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label for="filterStatus" class="form-label fw-semibold">Trạng thái</label>
                <select id="filterStatus" name="status" asp-items="filterStatuses" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                </select>
            </div>
            <div class="col-12 col-md-6 col-xl-3 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Lọc</button>
                <a asp-controller="Classes" asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </div>
    </form>
    <p class="text-muted small">Tổng cộng @pagination.TotalCount lớp học@(hasFilters ? " phù hợp với bộ lọc" : "").</p>

    <div class="class-table-card">
        <div class="table-responsive">
            <table class="table table-hover class-table dashboard-table">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Mã lớp</th>
                        <th>Môn học</th>
                        <th>Thời gian khóa</th>
                        <th>Lịch học (thứ / ca)</th>
                        <th>Giáo viên</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(++rowNumber)</td>
                                <td class="class-code">@item.Name</td>
                                <td>@(item.Subject?.Name ?? "Chưa có môn học")</td>
                                <td class="text-nowrap">@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</td>
                                <td class="adminclassindex-column">
                                    @if (item.ClassSchedules != null && item.ClassSchedules.Any())
                                    {
                                        foreach (var schedule in item.ClassSchedules.OrderBy(s => s.DayOfWeek))
                                        {
                                            var dayText = schedule.DayOfWeek == 8 ? "CN" : $"Thứ {schedule.DayOfWeek}";
                                            <div class="schedule-chip">
                                                <strong>@dayText</strong> · @(schedule.TimeSlot?.Name ?? "Ca không xác định")
                                                @if (schedule.TimeSlot != null)
                                                {
                                                    <span>(@schedule.TimeSlot.StartTime.ToString("HH:mm")–@schedule.TimeSlot.EndTime.ToString("HH:mm"))</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có lịch</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Teacher == null)
                                    {
                                        @if (item.Status == ClassStatus.Draft || item.Status == ClassStatus.Open)
                                        {
                                        <button type="button" class="btn btn-sm btn-outline-danger quick-assign-btn" data-class-id="@item.Id">
                                            Chưa phân công · Gán ngay
                                        </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa phân công</span>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">@item.Teacher.FullName</div>
                                        @if (item.Status == ClassStatus.Draft || item.Status == ClassStatus.Open)
                                        {
                                            <button type="button" class="btn btn-sm btn-link p-0 quick-assign-btn" data-class-id="@item.Id">Đổi giáo viên</button>
                                        }
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case ClassStatus.Draft:
                                            <span class="status-badge status-draft">Bản nháp</span>
                                            break;
                                        case ClassStatus.Open:
                                            <span class="status-badge status-open">Mở đăng ký</span>
                                            break;
                                        case ClassStatus.InProgress:
                                            <span class="status-badge status-progress">Đang học</span>
                                            break;
                                        case ClassStatus.Completed:
                                            <span class="status-badge status-completed">Hoàn thành</span>
                                            break;
                                        case ClassStatus.Cancelled:
                                            <span class="status-badge status-cancelled">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="status-badge status-draft">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-success mb-1 capacity-btn" data-class-id="@item.Id">Xem sĩ số</button>
                                    <a asp-controller="Classes" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mb-1">Chi tiết</a>
                                    @if (item.Status == ClassStatus.Draft)
                                    {
                                        <a asp-controller="Classes" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mb-1">Sửa</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center py-5">
                            @if (hasFilters)
                            {
                                <span>Không có lớp học phù hợp. Hãy thay đổi điều kiện hoặc </span>
                                <a asp-controller="Classes" asp-action="Index">xóa bộ lọc</a><span>.</span>
                            }
                            else
                            {
                                <span>Chưa có lớp học nào. Nhấn <strong>Mở lớp học mới</strong> để bắt đầu.</span>
                            }
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pagination" model="pagination" />
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary mt-3">← Quay lại tổng quan</a>
</div>

<!-- MODAL TẠO LỚP -->
<div class="modal fade" id="createClassModal" tabindex="-1" aria-labelledby="createClassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="createClassModalLabel">Mở lớp học mới</h5>
                    <div class="text-muted small">Khai báo lớp, học phí, lịch theo từng thứ và giáo viên phụ trách</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-controller="Classes" asp-action="Create" method="post" id="createClassForm" data-class-dates>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" id="createValidationSummary"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="SubjectId" class="form-label fw-semibold">Môn học (*)</label>
                            <select id="SubjectId" name="SubjectId" class="form-select form-select-lg fs-6" required>
                                <option value="">-- Chọn môn học --</option>
                                @foreach (var subject in subjects)
                                {
                                    <option value="@subject.Value">@subject.Text</option>
                                }
                            </select>
                            <span class="text-danger small" data-valmsg-for="SubjectId"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="Name" class="form-label fw-semibold">Mã lớp / tên lớp (*)</label>
                            <input id="Name" name="Name" class="form-control form-control-lg fs-6" maxlength="100" placeholder="VD: MAT10-A1" required />
                            <span class="text-danger small" data-valmsg-for="Name"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="StartDate" class="form-label fw-semibold">Ngày bắt đầu (*)</label>
                            <input id="StartDate" name="StartDate" type="date" class="form-control form-control-lg fs-6" value="@minStartDate.ToString("yyyy-MM-dd")" min="@minStartDate.ToString("yyyy-MM-dd")" required />
                            <span class="text-danger small" data-valmsg-for="StartDate" aria-live="polite"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="EndDate" class="form-label fw-semibold">Ngày kết thúc (*)</label>
                            <input id="EndDate" name="EndDate" type="date" class="form-control form-control-lg fs-6" min="@minStartDate.AddDays(1).ToString("yyyy-MM-dd")" required />
                            <span class="text-danger small" data-valmsg-for="EndDate" aria-live="polite"></span>
                        </div>
                        <div class="col-md-6">
                            <label for="MaxStudents" class="form-label fw-semibold">Sĩ số tối đa (*)</label>
                            <input id="MaxStudents" name="MaxStudents" type="number" class="form-control form-control-lg fs-6" min="1" max="1000" value="20" required />
                        </div>
                        <div class="col-md-6">
                            <label for="Fee" class="form-label fw-semibold">Học phí (VNĐ) (*)</label>
                            <input id="Fee" name="Fee" type="number" class="form-control form-control-lg fs-6" min="0" step="any" value="0" required />
                        </div>
                        <div class="col-md-6">
                            <label for="TeacherId" class="form-label fw-semibold">Giáo viên phụ trách (tùy chọn)</label>
                            <select id="TeacherId" name="TeacherId" class="form-select form-select-lg fs-6">
                                <option value="">-- Chưa phân công giáo viên --</option>
                                @foreach (var teacher in teachers)
                                {
                                    <option value="@teacher.Value">@teacher.Text</option>
                                }
                            </select>
                            <span class="text-danger small" data-valmsg-for="TeacherId"></span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h6 class="fw-bold mb-1">Thiết lập lịch học trong tuần (*)</h6>
                            <div class="text-muted small">Mỗi thứ chỉ chọn một ca; các thứ khác nhau có thể chọn ca khác nhau.</div>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="addCreateScheduleBtn">＋ Thêm lịch</button>
                    </div>
                    <div id="createScheduleContainer">
                        <div class="row g-2 align-items-end border rounded-3 p-3 mb-2 schedule-row">
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Thứ trong tuần</label>
                                <select name="Schedules[0].DayOfWeek" class="form-select day-select" required>
                                    <option value="2">Thứ 2</option>
                                    <option value="3">Thứ 3</option>
                                    <option value="4">Thứ 4</option>
                                    <option value="5">Thứ 5</option>
                                    <option value="6">Thứ 6</option>
                                    <option value="7">Thứ 7</option>
                                    <option value="8">Chủ nhật</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Ca học</label>
                                <select name="Schedules[0].TimeSlotId" class="form-select slot-select" required>
                                    <option value="">-- Chọn ca học --</option>
                                    @foreach (var slot in timeSlots)
                                    {
                                        <option value="@slot.Value">@slot.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-danger w-100 remove-schedule">Xóa</button>
                            </div>
                        </div>
                    </div>
                    <template id="createScheduleTemplate">
                        <div class="row g-2 align-items-end border rounded-3 p-3 mb-2 schedule-row">
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Thứ trong tuần</label>
                                <select class="form-select day-select" data-field="DayOfWeek" required>
                                    <option value="2">Thứ 2</option>
                                    <option value="3">Thứ 3</option>
                                    <option value="4">Thứ 4</option>
                                    <option value="5">Thứ 5</option>
                                    <option value="6">Thứ 6</option>
                                    <option value="7">Thứ 7</option>
                                    <option value="8">Chủ nhật</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Ca học</label>
                                <select class="form-select slot-select" data-field="TimeSlotId" required>
                                    <option value="">-- Chọn ca học --</option>
                                    @foreach (var slot in timeSlots)
                                    {
                                        <option value="@slot.Value">@slot.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100 remove-schedule">Xóa</button></div>
                        </div>
                    </template>
                    <div id="createScheduleError" class="conflict-box" role="alert"></div>
                    <div class="alert alert-info mt-3 mb-0">Nếu chưa phân công giáo viên, lớp được tạo ở trạng thái <strong>Draft</strong>. Có thể gán giáo viên sau.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-purple" id="createClassSubmit">Lưu &amp; mở lớp học</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL PHÂN CÔNG GIÁO VIÊN -->
<div class="modal fade" id="assignTeacherModal" tabindex="-1" aria-labelledby="assignTeacherTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div><h5 class="modal-title" id="assignTeacherTitle">Phân công giáo viên</h5><div class="text-muted small" id="assignClassSchedule">Đang tải lịch học...</div></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="assignTeacherForm" method="post" action="@Url.Action("AssignTeacher", "Classes")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="ClassId" id="assignClassId" />
                    <div class="mb-3"><label for="assignTeacherId" class="form-label fw-semibold">Giáo viên phụ trách</label><select name="TeacherId" id="assignTeacherId" class="form-select form-select-lg fs-6" required><option value="">-- Chọn giáo viên --</option></select></div>
                    <div id="assignConflict" class="conflict-box" role="alert"></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-purple" id="assignTeacherSubmit">Lưu phân công</button></div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL XEM SĨ SỐ -->
<div class="modal fade" id="capacityModal" tabindex="-1" aria-labelledby="capacityTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><div><h5 class="modal-title" id="capacityTitle">Chi tiết sĩ số lớp</h5><div class="text-muted small" id="capacitySubtitle">Đang tải...</div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-3 mb-3 small">
                    <span><span class="badge adminclassindex-confirmed-badge">&nbsp;</span> Đã xác nhận: <strong id="capacityConfirmed">0</strong></span>
                    <span><span class="badge adminclassindex-reserved-badge">&nbsp;</span> Đang giữ chỗ: <strong id="capacityReserved">0</strong></span>
                    <span><span class="badge adminclassindex-free-badge">&nbsp;</span> Còn trống: <strong id="capacityAvailable">0</strong></span>
                </div>
                <div class="capacity-track mb-4"><div id="capacityConfirmedBar" class="capacity-confirmed adminclassindex-empty-bar"></div><div id="capacityReservedBar" class="capacity-reserved adminclassindex-empty-bar"></div><div id="capacityFreeBar" class="capacity-free adminclassindex-full-bar"></div></div>
                <div class="table-responsive"><table class="table table-sm table-hover align-middle"><thead class="table-light"><tr><th>Học sinh</th><th>Mã phụ huynh</th><th>Hạn giữ chỗ</th><th>Trạng thái</th></tr></thead><tbody id="capacityStudents"><tr><td colspan="4" class="text-center text-muted">Đang tải...</td></tr></tbody></table></div>
                <div id="capacityError" class="text-danger small"></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
