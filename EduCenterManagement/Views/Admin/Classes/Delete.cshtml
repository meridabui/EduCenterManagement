@model EduCenterManagement.Models.Class

@using EduCenterManagement.Enums

@{
    ViewData["Title"] = "Hủy lớp học";
}

<div class="mx-auto adminclassdelete-container">
    <h1 class="h3 fw-bold mb-4">Hủy lớp học</h1>

    <div class="alert alert-warning">
        Bạn có chắc chắn muốn hủy lớp học này không?
        Lớp sẽ chuyển sang trạng thái Cancelled
    </div>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-header bg-white border-bottom p-4 fw-bold">
            Thông tin lớp học
        </div>

        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-4">Mã lớp</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Tên lớp</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Môn học</dt>
                <dd class="col-sm-8">
                    @(Model.Subject?.Name ?? "Không xác định")
                </dd>

                <dt class="col-sm-4">Giáo viên phụ trách</dt>
                <dd class="col-sm-8">
                    @(Model.Teacher?.FullName ?? "Chưa phân công")
                </dd>

                <dt class="col-sm-4">Thời gian</dt>
                <dd class="col-sm-8">
                    @Model.StartDate.ToString("dd/MM/yyyy")
                    – @Model.EndDate.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-4">Sĩ số tối đa</dt>
                <dd class="col-sm-8">@Model.MaxStudents học viên</dd>

                <dt class="col-sm-4">Trạng thái hiện tại</dt>
                <dd class="col-sm-8">
                    @Model.Status
                </dd>
            </dl>
        </div>

        <div class="card-footer bg-white border-top p-4 d-flex flex-wrap gap-2">
            @if (Model.Status == ClassStatus.Draft || Model.Status == ClassStatus.Open)
            {
                <form asp-controller="Classes"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Xác nhận hủy lớp
                    </button>
                </form>
            }
            else
            {
                <span class="text-secondary">
                    Lớp này đã ngừng sử dụng.
                </span>
            }

            <a asp-controller="Classes"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>
