

@model EduCenterManagement.ViewModels.Admin.ClassViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Thêm lớp học";
    var minStartDate = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).AddDays(1);

    var days = ViewBag.DaysOfWeek as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();

    var timeSlots = ViewBag.TimeSlots as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();
}

<div class="mx-auto mb-4 adminclasscreate-container">
    <h1 class="h3 fw-bold mb-4">Mở lớp học mới</h1>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <form asp-controller="Classes"
                  asp-action="Create"
                  method="post" id="standaloneCreateClassForm" data-class-dates
                  data-teachers-url="@Url.Action("GetTeachersBySubject", "Classes")">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <h5 class="mb-3">1. Thông tin lớp học</h5>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name"
                           class="form-control form-control-lg fs-6"
                           placeholder="Ví dụ: Toán A1" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SubjectId" class="form-label fw-semibold"></label>
                    <select asp-for="SubjectId"
                            asp-items="ViewBag.Subjects"
                            class="form-select form-select-lg fs-6">
                        <option value="">-- Chọn môn học --</option>
                    </select>
                    <span asp-validation-for="SubjectId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TeacherId" class="form-label fw-semibold"></label>
                    <select asp-for="TeacherId"
                            asp-items="ViewBag.Teachers"
                            class="form-select form-select-lg fs-6">
                        <option value="">-- Chưa phân công giáo viên --</option>
                    </select>
                    <span asp-validation-for="TeacherId"
                          class="text-danger"></span>
                    <small class="text-muted">
                        Giáo viên phải thuộc môn học đã chọn.
                        Bạn có thể phân công sau.
                    </small>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate"
                               type="date"
                               min="@minStartDate.ToString("yyyy-MM-dd")" required
                               class="form-control form-control-lg fs-6" />
                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate"
                               type="date"
                               min="@minStartDate.AddDays(1).ToString("yyyy-MM-dd")" required
                               class="form-control form-control-lg fs-6" />
                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxStudents" class="form-label fw-semibold"></label>
                    <input asp-for="MaxStudents"
                           type="number"
                           min="1"
                           max="1000"
                           class="form-control form-control-lg fs-6" />
                    <span asp-validation-for="MaxStudents"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Fee" class="form-label fw-semibold"></label>
                    <input asp-for="Fee"
                           type="number"
                           min="0"
                           step="any"
                           class="form-control form-control-lg fs-6" />
                    <span asp-validation-for="Fee"
                          class="text-danger"></span>
                </div>

                <hr />

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h5 class="mb-1">2. Lịch học định kỳ</h5>
                        <p class="text-muted small mb-0">
                            Chọn thứ và khung giờ cho từng buổi học.
                        </p>
                    </div>

                    <button type="button"
                            id="addScheduleBtn"
                            class="btn btn-outline-primary">
                        + Thêm buổi học
                    </button>
                </div>

                <div id="scheduleValidation"
                     class="text-danger mb-2"></div>

                <div id="scheduleContainer">
                    @if (Model.Schedules != null)
                    {
                        for (int i = 0; i < Model.Schedules.Count; i++)
                        {
                            <div class="schedule-row border rounded-3 p-3 mb-3">
                                <div class="row align-items-end">
                                    <div class="col-md-5 mb-2">
                                        <label class="form-label fw-semibold"
                                               for="Schedules_@(i)__DayOfWeek">
                                            Thứ trong tuần
                                        </label>

                                        <select asp-for="Schedules[i].DayOfWeek"
                                                asp-items="ViewBag.DaysOfWeek"
                                                class="form-select day-select">
                                        </select>

                                        <span asp-validation-for="Schedules[i].DayOfWeek"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="col-md-5 mb-2">
                                        <label class="form-label fw-semibold"
                                               for="Schedules_@(i)__TimeSlotId">
                                            Khung giờ
                                        </label>

                                        <select asp-for="Schedules[i].TimeSlotId"
                                                asp-items="ViewBag.TimeSlots"
                                                class="form-select slot-select">
                                            <option value="">-- Chọn khung giờ --</option>
                                        </select>

                                        <span asp-validation-for="Schedules[i].TimeSlotId"
                                              class="text-danger"></span>
                                    </div>

                                    <div class="col-md-2 mb-2">
                                        <button type="button"
                                                class="btn btn-outline-danger remove-schedule w-100">
                                            Xóa
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <template id="scheduleTemplate">
                    <div class="schedule-row border rounded-3 p-3 mb-3">
                        <div class="row align-items-end">
                            <div class="col-md-5 mb-2">
                                <label class="form-label fw-semibold"
                                       for="Schedules___index___DayOfWeek">
                                    Thứ trong tuần
                                </label>

                                <select name="Schedules[__index__].DayOfWeek"
                                        id="Schedules___index___DayOfWeek"
                                        class="form-select day-select"
                                        required>
                                    @foreach (var day in days)
                                    {
                                        <option value="@day.Value">@day.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-5 mb-2">
                                <label class="form-label fw-semibold"
                                       for="Schedules___index___TimeSlotId">
                                    Khung giờ
                                </label>

                                <select name="Schedules[__index__].TimeSlotId"
                                        id="Schedules___index___TimeSlotId"
                                        class="form-select slot-select"
                                        required>
                                    <option value="">-- Chọn khung giờ --</option>
                                    @foreach (var slot in timeSlots)
                                    {
                                        <option value="@slot.Value">@slot.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2 mb-2">
                                <button type="button"
                                        class="btn btn-outline-danger remove-schedule w-100">
                                    Xóa
                                </button>
                            </div>
                        </div>
                    </div>
                </template>

                <div class="alert alert-info mt-3">
                    Lớp sẽ được tạo ở trạng thái <strong>Draft</strong>.
                    Lớp và các lịch học được lưu cùng nhau.
                    Bạn có thể phân công giáo viên sau, rồi mở đăng ký
                    khi lớp đã đáp ứng đủ điều kiện.
                </div>

                <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Tạo lớp học
                    </button>

                    <a asp-controller="Classes"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
