@model EduCenterManagement.ViewModels.Admin.SubjectViewModel

@{
    ViewData["Title"] = "Thêm môn học";
}

<div class="container mt-4" style="max-width: 700px;">
    <h2 class="mb-4">Thêm môn học</h2>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-controller="Subjects"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Nhập tên môn học" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập mô tả môn học (không bắt buộc)"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<EduCenterManagement.Enums.SubjectStatus>()"
                            class="form-select">
                    </select>
                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Lưu môn học
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
