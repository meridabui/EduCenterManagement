@model EduCenterManagement.ViewModels.Admin.SubjectViewModel

@{
    ViewData["Title"] = "Sửa môn học";
}

<div class="mx-auto" style="max-width: 760px;">
    <h1 class="h3 fw-bold mb-2">Sửa môn học</h1><p class="text-muted mb-4">Cập nhật thông tin và trạng thái của môn học.</p>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <form asp-controller="Subjects"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control form-control-lg fs-6" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label fw-semibold"></label>
                    <textarea asp-for="Description"
                              class="form-control form-control-lg fs-6"
                              rows="4"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<EduCenterManagement.Enums.SubjectStatus>()"
                            class="form-select form-select-lg fs-6">
                    </select>
                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

                <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Lưu thay đổi
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
