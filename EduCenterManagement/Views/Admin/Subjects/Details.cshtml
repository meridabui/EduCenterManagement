@model EduCenterManagement.Models.Subject


@{
    ViewData["Title"] = "Chi tiết môn học";
}

<div class="mx-auto adminsubjectdetails-container">
    <h1 class="h3 fw-bold mb-2">Chi tiết môn học</h1><p class="text-muted mb-4">Xem thông tin và lịch sử cập nhật của môn học.</p>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-header bg-white border-bottom p-4 fw-bold">
            Thông tin môn học
        </div>

        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Tên môn học</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Mô tả</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Chưa có mô tả"
                        : Model.Description)
                </dd>

                <dt class="col-sm-4">Trạng thái</dt>
                <dd class="col-sm-8">
                    @if (Model.Status ==
                        EduCenterManagement.Enums.SubjectStatus.Active)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Ngừng hoạt động
                        </span>
                    }
                </dd>

                <dt class="col-sm-4">Ngày tạo</dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">Cập nhật lần cuối</dt>
                <dd class="col-sm-8">
                    @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>
        </div>

        <div class="card-footer bg-white border-top p-4 d-flex flex-wrap gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Sửa môn học
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>
