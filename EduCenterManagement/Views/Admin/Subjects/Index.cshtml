@model IEnumerable<EduCenterManagement.Models.Subject>

@{
    ViewData["Title"] = "Quản lý môn học";
    var pagination = (EduCenterManagement.ViewModels.Admin.PaginationViewModel)ViewBag.Pagination;
    var rowNumber = pagination.Offset;
}

<div class="admin-management-page">
    <div class="dashboard-heading flex-wrap">
        <h1 class="h3 fw-bold mb-0">Quản lý môn học</h1>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm môn học
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <div class="table-responsive"><table class="table table-hover dashboard-table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Tên môn học</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var subject in Model)
                        {
                            <tr>
                                <td>@(++rowNumber)</td>
                                <td>@subject.Name</td>
                                <td>@subject.Description</td>
                                <td>
                                    @if (subject.Status ==
                                        EduCenterManagement.Enums.SubjectStatus.Active)
                                    {
                                        <span class="badge bg-success">
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Ngừng hoạt động
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@subject.Id"
                                       class="btn btn-sm btn-outline-primary mb-1">
                                        Chi tiết
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@subject.Id"
                                       class="btn btn-sm btn-outline-secondary mb-1">
                                        Sửa
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@subject.Id"
                                       class="btn btn-sm btn-outline-danger mb-1">
                                        Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">
                                Chưa có môn học nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
            <partial name="_Pagination" model="pagination" />
        </div>
    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Quay lại tổng quan
    </a>
</div>
