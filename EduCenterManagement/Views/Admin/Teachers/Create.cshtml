@model EduCenterManagement.ViewModels.Admin.CreateTeacherViewModel


@{
    ViewData["Title"] = "Thêm giáo viên";
}

<div class="mx-auto adminteachercreate-container">
    <h1 class="h3 fw-bold mb-2">Tạo tài khoản giáo viên</h1><p class="text-muted mb-4">Thiết lập tài khoản và chọn môn giảng dạy cho giáo viên.</p>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <form asp-controller="Teachers"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                    <input asp-for="FullName" class="form-control form-control-lg fs-6"
                           placeholder="Nhập họ tên giáo viên" />
                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <fieldset>
                        <legend class="fs-6">Môn được phân công</legend>
                        @foreach (var subject in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Subjects)
                        {
                            <div class="form-check mb-2">
                                <input type="checkbox" name="SubjectIds" value="@subject.Value"
                                       id="subject-@subject.Value" checked="@subject.Selected"
                                       class="form-check-input" />
                                <label for="subject-@subject.Value" class="form-check-label">@subject.Text</label>
                            </div>
                        }
                        <span asp-validation-for="SubjectIds" class="text-danger"></span>
                        <small class="form-text text-muted d-block">Chọn ít nhất một môn. Giáo viên có thể được phân công nhiều môn.</small>
                    </fieldset>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control form-control-lg fs-6"
                           placeholder="teacher@example.com" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control form-control-lg fs-6"
                           autocomplete="new-password" />
                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword"
                           class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg fs-6"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Tạo tài khoản
                    </button>

                    <a asp-controller="Teachers"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
