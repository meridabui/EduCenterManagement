@model EduCenterManagement.ViewModels.Admin.AssignTeacherSubjectsViewModel

@{
    ViewData["Title"] = "Quản lý môn của giáo viên";
}

<div class="mx-auto" style="max-width: 760px;">
    <h1 class="h3 fw-bold">Quản lý môn của giáo viên</h1>
    <p class="text-muted">@ViewBag.TeacherName</p>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <form asp-controller="Teachers" asp-action="AssignSubjects" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="TeacherId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <fieldset class="mb-3">
                    <legend class="fs-6">Môn được phân công</legend>
                    @foreach (var subject in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Subjects)
                    {
                        <div class="form-check mb-2">
                            <input type="checkbox" name="SubjectIds" value="@subject.Value"
                                   id="subject-@subject.Value" checked="@subject.Selected"
                                   class="form-check-input" />
                            <label for="subject-@subject.Value" class="form-check-label">@subject.Text</label>
                        </div>
                    }
                    <span asp-validation-for="SubjectIds" class="text-danger"></span>
                    <small class="form-text text-muted d-block mt-2">
                        Chọn ít nhất một môn. Chỉ được thêm môn đang hoạt động.
                        Không thể bỏ môn khi giáo viên vẫn phụ trách lớp chưa hoàn thành hoặc chưa hủy.
                    </small>
                </fieldset>

                <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-4">
                    <button type="submit" class="btn btn-primary">Lưu phân công</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
