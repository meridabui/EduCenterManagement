@model IEnumerable<EduCenterManagement.Models.TeacherProfile>

@{
    ViewData["Title"] = "Quản lý Teacher";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý Teacher</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm Teacher
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Họ và tên</th>
                <th>Email</th>
                <th>Trạng thái</th>
                <th>Môn được phân công</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var teacher in Model)
                {
                    <tr>
                        <td>@teacher.Id</td>
                        <td>@teacher.FullName</td>
                        <td>@teacher.User.Email</td>
                        <td>@teacher.User.Status</td>
                        <td>
                            @foreach (var assignment in teacher.TeacherSubjects.OrderBy(ts => ts.Subject.Name))
                            {
                                <span class="badge bg-secondary me-1 mb-1">
                                    @assignment.Subject.Name
                                    @if (assignment.Subject.Status == EduCenterManagement.Enums.SubjectStatus.Inactive)
                                    {
                                        <span>(ngừng hoạt động)</span>
                                    }
                                </span>
                            }
                        </td>
                        <td>
                            <a asp-action="AssignSubjects" asp-route-id="@teacher.Id"
                               class="btn btn-sm btn-outline-primary">Quản lý môn</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        Chưa có Teacher nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="Admin" asp-action="Index"
       class="btn btn-outline-secondary">
        Quay lại Dashboard
    </a>
</div>
