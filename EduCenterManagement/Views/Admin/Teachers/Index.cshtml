@model IEnumerable<EduCenterManagement.Models.TeacherProfile>

@{
    ViewData["Title"] = "Quản lý giáo viên";
}

<div class="admin-management-page">
    <div class="dashboard-heading flex-wrap">
        <h1 class="h3 fw-bold mb-0">Quản lý giáo viên</h1>

        <a asp-action="Create" class="btn btn-primary">
            + Thêm giáo viên
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <section class="dashboard-panel p-0 overflow-hidden mb-4"><div class="table-responsive"><table class="table table-hover dashboard-table align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Họ và tên</th>
                <th>Email</th>
                <th>Trạng thái</th>
                <th>Môn được phân công</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var teacher in Model)
                {
                    <tr>
                        <td>@teacher.Id</td>
                        <td>@teacher.FullName</td>
                        <td>@teacher.User.Email</td>
                        <td><span class="badge bg-light text-dark border">@teacher.User.Status</span></td>
                        <td>
                            @foreach (var assignment in teacher.TeacherSubjects.OrderBy(ts => ts.Subject.Name))
                            {
                                <span class="badge bg-secondary me-1 mb-1">
                                    @assignment.Subject.Name
                                    @if (assignment.Subject.Status == EduCenterManagement.Enums.SubjectStatus.Inactive)
                                    {
                                        <span>(ngừng hoạt động)</span>
                                    }
                                </span>
                            }
                        </td>
                        <td>
                            <a asp-action="AssignSubjects" asp-route-id="@teacher.Id"
                               class="btn btn-sm btn-outline-primary">Quản lý môn</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        Chưa có giáo viên nào.
                    </td>
                </tr>
            }
        </tbody>
    </table></div></section>

    <a asp-controller="Admin" asp-action="Index"
       class="btn btn-outline-secondary">
        Quay lại tổng quan
    </a>
</div>
