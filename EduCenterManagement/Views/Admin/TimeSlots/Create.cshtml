@model EduCenterManagement.ViewModels.Admin.TimeSlotViewModel

@{
    ViewData["Title"] = "Thêm khung giờ";
}

<div class="mx-auto" style="max-width: 760px;">
    <h1 class="h3 fw-bold mb-2">Thêm khung giờ học</h1>
    <p class="text-muted mb-4">Quản lý thời gian bắt đầu và kết thúc của ca học.</p>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <form asp-controller="TimeSlots"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name"
                           class="form-control form-control-lg fs-6"
                           placeholder="Ví dụ: Ca sáng" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartTime" class="form-label fw-semibold"></label>
                    <input asp-for="StartTime"
                           type="time"
                           class="form-control form-control-lg fs-6"
                           step="60" />
                    <span asp-validation-for="StartTime"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndTime" class="form-label fw-semibold"></label>
                    <input asp-for="EndTime"
                           type="time"
                           class="form-control form-control-lg fs-6"
                           step="60" />
                    <span asp-validation-for="EndTime"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    Giờ kết thúc phải sau giờ bắt đầu.
                    Các khung giờ không được chồng lấn nhau.
                </div>

                <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Lưu khung giờ
                    </button>

                    <a asp-controller="TimeSlots"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
