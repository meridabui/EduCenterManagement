@model IEnumerable<EduCenterManagement.Models.TimeSlot>


@{
    ViewData["Title"] = "Quản lý khung giờ";
}

<div class="admin-management-page">
    <div class="dashboard-heading flex-wrap">
        <h1 class="h3 fw-bold mb-0">Quản lý khung giờ học</h1>

        <div class="d-flex gap-2">
            <form asp-controller="TimeSlots"
                  asp-action="GenerateDefaultSlots"
                  method="post"
                  class="d-inline"
                  data-confirm="Bạn có chắc chắn muốn tự động tạo 6 khung giờ mặc định (Slot 1 đến Slot 6)?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                     Khởi tạo khung giờ mặc định
                </button>
            </form>

            <a asp-controller="TimeSlots"
               asp-action="Create"
               class="btn btn-primary">
                + Thêm khung giờ
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover dashboard-table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên khung giờ</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Trạng thái</th>
                            <th class="admintimeslotindex-column">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var slot in Model)
                            {
                                <tr>
                                    <td>@slot.Id</td>
                                    <td>@slot.Name</td>
                                    <td>@slot.StartTime.ToString("HH:mm")</td>
                                    <td>@slot.EndTime.ToString("HH:mm")</td>

                                    <td>
                                        @if (slot.Status ==
                                            EduCenterManagement.Enums.TimeSlotStatus.Active)
                                        {
                                            <span class="badge bg-success">
                                                Đang hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Ngừng hoạt động
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="TimeSlots"
                                           asp-action="Details"
                                           asp-route-id="@slot.Id"
                                           class="btn btn-sm btn-outline-primary mb-1">
                                            Chi tiết
                                        </a>

                                        <a asp-controller="TimeSlots"
                                           asp-action="Edit"
                                           asp-route-id="@slot.Id"
                                           class="btn btn-sm btn-outline-secondary mb-1">
                                            Sửa
                                        </a>

                                        @if (slot.Status ==
                                            EduCenterManagement.Enums.TimeSlotStatus.Active)
                                        {
                                            <a asp-controller="TimeSlots"
                                               asp-action="Delete"
                                               asp-route-id="@slot.Id"
                                               class="btn btn-sm btn-outline-danger mb-1">
                                                Ngừng kích hoạt
                                            </a>
                                        }
                                        else
                                        {
                                            <form asp-controller="TimeSlots"
                                                  asp-action="Reactivate"
                                                  asp-route-id="@slot.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success mb-1">
                                                    Kích hoạt lại
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <p class="text-muted mb-3 fs-6">Chưa có khung giờ học nào trong hệ thống.</p>
                                    <form asp-controller="TimeSlots"
                                          asp-action="GenerateDefaultSlots"
                                          method="post"
                                          class="d-inline me-2"
                                          data-confirm="Bạn có chắc chắn muốn tự động tạo 6 khung giờ mặc định (Slot 1 đến Slot 6)?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success">
                                             Khởi tạo 6 khung giờ mặc định (Slot 1 - 6)
                                        </button>
                                    </form>
                                    <a asp-controller="TimeSlots"
                                       asp-action="Create"
                                       class="btn btn-outline-primary">
                                        + Thêm thủ công
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Quay lại tổng quan
    </a>
</div>
