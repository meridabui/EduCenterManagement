@model EduCenterManagement.ViewModels.Admin.TimeSlotViewModel


@{
    ViewData["Title"] = "Sửa khung giờ";
}

<div class="mx-auto admintimeslotedit-container">
    <h1 class="h3 fw-bold mb-2">Sửa khung giờ học</h1>
    <p class="text-muted mb-4">Quản lý thời gian bắt đầu và kết thúc của ca học.</p>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-body p-4">
            <form asp-controller="TimeSlots"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                @if (Model.IsTimeLocked)
                {
                    <div class="alert alert-info" id="time-lock-help">
                        <p class="mb-2"><strong>Giờ học đã khóa.</strong> Khung giờ này đã được lớp sử dụng.
                            Bạn vẫn có thể sửa tên; giờ bắt đầu và kết thúc được giữ nguyên.</p>
                        <ul class="mb-2">
                            @foreach (var classItem in Model.UsedByClasses)
                            {
                                <li><a asp-controller="Classes" asp-action="Details" asp-route-id="@classItem.Id">@classItem.Name</a></li>
                            }
                        </ul>
                        <a asp-controller="TimeSlots" asp-action="Create">Thêm khung giờ mới</a> nếu cần giờ học khác.
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control form-control-lg fs-6" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartTime" class="form-label fw-semibold"></label>
                    <input asp-for="StartTime"
                           type="time"
                           readonly="@Model.IsTimeLocked"
                           aria-describedby="@(Model.IsTimeLocked ? "time-lock-help" : null)"
                           class="form-control form-control-lg fs-6"
                           step="60" />
                    <span asp-validation-for="StartTime"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndTime" class="form-label fw-semibold"></label>
                    <input asp-for="EndTime"
                           type="time"
                           readonly="@Model.IsTimeLocked"
                           aria-describedby="@(Model.IsTimeLocked ? "time-lock-help" : null)"
                           class="form-control form-control-lg fs-6"
                           step="60" />
                    <span asp-validation-for="EndTime"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    Giờ kết thúc phải sau giờ bắt đầu.
                    Khung giờ không được chồng lấn với khung giờ khác.
                </div>

                <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Lưu thay đổi
                    </button>

                    <a asp-controller="TimeSlots"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
