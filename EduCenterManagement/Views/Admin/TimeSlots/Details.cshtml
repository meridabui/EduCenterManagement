@model EduCenterManagement.Models.TimeSlot


@{
    ViewData["Title"] = "Chi tiết khung giờ";
}

<div class="mx-auto admintimeslotdetails-container">
    <h1 class="h3 fw-bold mb-2">Chi tiết khung giờ học</h1>
    <p class="text-muted mb-4">Quản lý thời gian bắt đầu và kết thúc của ca học.</p>

    <div class="card border-0 dashboard-panel p-0 overflow-hidden">
        <div class="card-header bg-white border-bottom p-4 fw-bold">
            Thông tin khung giờ
        </div>

        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Tên khung giờ</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Giờ bắt đầu</dt>
                <dd class="col-sm-8">
                    @Model.StartTime.ToString("HH:mm")
                </dd>

                <dt class="col-sm-4">Giờ kết thúc</dt>
                <dd class="col-sm-8">
                    @Model.EndTime.ToString("HH:mm")
                </dd>

                <dt class="col-sm-4">Ngày tạo</dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">Cập nhật lần cuối</dt>
                <dd class="col-sm-8">
                    @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>
        </div>

        <div class="card-footer bg-white border-top p-4 d-flex flex-wrap gap-2">
            <a asp-controller="TimeSlots"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Sửa khung giờ
            </a>

            <a asp-controller="TimeSlots"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>
