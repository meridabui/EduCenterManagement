@model EduCenterManagement.Models.TimeSlot

@{
    ViewData["Title"] = "Chi tiết khung giờ";
}

<div class="container mt-4" style="max-width: 700px;">
    <h2 class="mb-4">Chi tiết khung giờ học</h2>

    <div class="card shadow-sm">
        <div class="card-header">
            Thông tin TimeSlot
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Tên khung giờ</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Giờ bắt đầu</dt>
                <dd class="col-sm-8">
                    @Model.StartTime.ToString("HH:mm")
                </dd>

                <dt class="col-sm-4">Giờ kết thúc</dt>
                <dd class="col-sm-8">
                    @Model.EndTime.ToString("HH:mm")
                </dd>

                <dt class="col-sm-4">Ngày tạo</dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">Cập nhật lần cuối</dt>
                <dd class="col-sm-8">
                    @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            <a asp-controller="TimeSlots"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Sửa khung giờ
            </a>

            <a asp-controller="TimeSlots"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Quay lại danh sách
            </a>
        </div>
    </div>
</div>
