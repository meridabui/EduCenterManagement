@using EduCenterManagement.ViewModels.Timetable
@model TimetableViewModel
@{ViewData["Title"]="My Timetable";var uid=Context.Request.Query["userId"].ToString();}
<h1>My Timetable</h1><div class="mb-3"><a class="btn btn-outline-secondary" asp-route-weekStart="@Model.WeekStart.AddDays(-7)" asp-route-userId="@uid">Previous week</a> <a class="btn btn-outline-secondary" asp-route-userId="@uid">This week</a> <a class="btn btn-outline-secondary" asp-route-weekStart="@Model.WeekStart.AddDays(7)" asp-route-userId="@uid">Next week</a></div><p>@Model.WeekStart.ToString("dd MMM") - @Model.WeekStart.AddDays(6).ToString("dd MMM yyyy")</p><div class="row row-cols-1 row-cols-md-7 g-2">@for(var i=0;i<7;i++){var day=Model.WeekStart.AddDays(i);var items=Model.Items.Where(x=>x.Date==day).ToList();<div class="col"><div class="border rounded p-2 timetable-day"><strong>@day.ToString("ddd dd")</strong>@if(!items.Any()){<p class="text-muted mt-2">No classes</p>}@foreach(var x in items){<div class="small border-top mt-2 pt-1"><b>@x.SubjectName</b><br/>@x.ClassName<br/>@x.StartsAt-@x.EndsAt<br/>@x.TeacherName</div>}</div></div>}</div>
