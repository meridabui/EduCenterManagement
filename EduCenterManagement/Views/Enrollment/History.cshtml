@using EduCenterManagement.Enums
@model EduCenterManagement.ViewModels.Registration.EnrollmentHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử đăng ký";
}

<div class="container-fluid px-0" style="max-width: 1280px;">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Lịch sử đăng ký</h2>
            <p class="text-muted mb-0">Theo dõi trạng thái đăng ký lớp học của các con.</p>
        </div>
        <a asp-action="Index" asp-route-studentId="@Model.SelectedStudentId" class="btn btn-primary"><i class="bi bi-journal-plus me-1"></i>Đăng ký lớp mới</a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>@successMessage</div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@errorMessage</div>
    }

    <form method="get" asp-action="History" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="studentId" class="form-label fw-semibold">Học sinh</label>
                    <select id="studentId" name="studentId" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả học sinh</option>
                        @foreach (var student in Model.Students)
                        {
                            <option value="@student.Id" selected="@(Model.SelectedStudentId == student.Id)">@student.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="status" class="form-label fw-semibold">Trạng thái</label>
                    <select id="status" name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả trạng thái</option>
                        <option value="@((byte)EnrollmentStatus.PendingPayment)" selected="@(Model.SelectedStatus == EnrollmentStatus.PendingPayment)">Chờ thanh toán</option>
                        <option value="@((byte)EnrollmentStatus.Confirm)" selected="@(Model.SelectedStatus == EnrollmentStatus.Confirm)">Đã thanh toán</option>
                        <option value="@((byte)EnrollmentStatus.PaymentFailed)" selected="@(Model.SelectedStatus == EnrollmentStatus.PaymentFailed)">Thanh toán thất bại</option>
                        <option value="@((byte)EnrollmentStatus.Expried)" selected="@(Model.SelectedStatus == EnrollmentStatus.Expried)">Hết hạn giữ chỗ</option>
                        <option value="@((byte)EnrollmentStatus.Cancelled)" selected="@(Model.SelectedStatus == EnrollmentStatus.Cancelled)">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <a asp-action="History" class="btn btn-outline-secondary">Xóa lọc</a>
                </div>
            </div>
        </div>
    </form>

    @if (!Model.Students.Any())
    {
        <div class="alert alert-warning">
            Bạn chưa có học sinh nào được liên kết. Hãy hoàn tất liên kết tại
            <a asp-controller="ParentDashboard" asp-action="Links">trang liên kết học sinh</a>.
        </div>
    }
    else if (!Model.Items.Any())
    {
        <div class="alert alert-info">Không có đăng ký nào phù hợp.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã</th>
                            <th>Học sinh</th>
                            <th>Lớp</th>
                            <th>Học phí</th>
                            <th>Trạng thái</th>
                            <th>Cập nhật</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong>#@item.EnrollmentId</strong>
                                    <div class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</div>
                                </td>
                                <td>@item.StudentName</td>
                                <td>
                                    <div class="fw-semibold">@item.ClassName</div>
                                    <div class="small text-muted">@item.SubjectName · @item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>@item.Fee.ToString("N0") đ</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case EnrollmentStatus.PendingPayment:
                                            <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                                            if (item.ReservedUntil.HasValue)
                                            {
                                                <div class="small text-danger fw-semibold history-countdown" data-until="@item.ReservedUntil.Value.ToString("o")"></div>
                                            }
                                            break;
                                        case EnrollmentStatus.Confirm:
                                            <span class="badge bg-success">Đã thanh toán</span>
                                            break;
                                        case EnrollmentStatus.PaymentFailed:
                                            <span class="badge bg-danger">Thanh toán thất bại</span>
                                            break;
                                        case EnrollmentStatus.Expried:
                                            <span class="badge bg-secondary">Hết hạn giữ chỗ</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Đã hủy</span>
                                            break;
                                    }
                                </td>
                                <td class="small text-muted">
                                    @{
                                        var changedAt = item.Status == EnrollmentStatus.Confirm && item.ConfirmedAt.HasValue ? item.ConfirmedAt.Value
                                            : item.Status == EnrollmentStatus.Cancelled && item.CancelledAt.HasValue ? item.CancelledAt.Value
                                            : item.UpdatedAt;
                                    }
                                    @changedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (item.IsHoldActive)
                                    {
                                        <a asp-action="Confirmation" asp-route-id="@item.EnrollmentId" class="btn btn-sm btn-success">Thanh toán</a>
                                    }
                                    else if (item.CanReRegister)
                                    {
                                        <a asp-action="Details" asp-route-id="@item.ClassId" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-outline-primary">Đăng ký lại</a>
                                    }
                                    <a asp-action="Confirmation" asp-route-id="@item.EnrollmentId" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const countdowns = document.querySelectorAll('.history-countdown');
        if (countdowns.length) {
            const tick = () => {
                countdowns.forEach(el => {
                    const left = Math.floor((new Date(el.dataset.until).getTime() - Date.now()) / 1000);
                    if (left <= 0) {
                        el.textContent = 'Đã hết hạn giữ chỗ — tải lại trang';
                        return;
                    }
                    const m = String(Math.floor(left / 60)).padStart(2, '0');
                    const s = String(left % 60).padStart(2, '0');
                    el.textContent = 'Còn ' + m + ':' + s;
                });
            };
            setInterval(tick, 1000);
            tick();
        }
    </script>
}
