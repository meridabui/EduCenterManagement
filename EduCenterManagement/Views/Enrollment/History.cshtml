@using EduCenterManagement.Enums
@model EduCenterManagement.ViewModels.Registration.EnrollmentHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử đăng ký";
}

<div class="container-fluid px-0" style="max-width: 1280px;">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primary border mb-2">Phụ huynh</span>
            <h1 class="fw-bold mb-1">Lịch sử đăng ký</h1>
            <p class="text-muted mb-0">Theo dõi trạng thái giữ chỗ, thanh toán và xác nhận lớp học.</p>
        </div>
        <a asp-action="Index" class="btn btn-primary"><i class="bi bi-journal-plus me-1"></i>Đăng ký lớp mới</a>
    </div>

    <form method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="studentId" class="form-label fw-semibold">Học sinh</label>
                    <select id="studentId" name="studentId" class="form-select">
                        <option value="">Tất cả học sinh</option>
                        @foreach (var student in Model.Students)
                        {
                            <option value="@student.Id" selected="@(Model.SelectedStudentId == student.Id)">@student.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="status" class="form-label fw-semibold">Trạng thái</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="@EnrollmentStatus.PendingPayment" selected="@(Model.SelectedStatus == EnrollmentStatus.PendingPayment)">Chờ thanh toán</option>
                        <option value="@EnrollmentStatus.Confirm" selected="@(Model.SelectedStatus == EnrollmentStatus.Confirm)">Đã thanh toán / xác nhận</option>
                        <option value="@EnrollmentStatus.Expried" selected="@(Model.SelectedStatus == EnrollmentStatus.Expried)">Hết hạn</option>
                        <option value="@EnrollmentStatus.PaymentFailed" selected="@(Model.SelectedStatus == EnrollmentStatus.PaymentFailed)">Thanh toán thất bại</option>
                        <option value="@EnrollmentStatus.Cancelled" selected="@(Model.SelectedStatus == EnrollmentStatus.Cancelled)">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i>Lọc</button>
                </div>
            </div>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info"><i class="bi bi-info-circle me-1"></i>Chưa có đăng ký nào phù hợp với bộ lọc.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã</th>
                            <th>Học sinh</th>
                            <th>Lớp học</th>
                            <th>Ngày đăng ký</th>
                            <th>Học phí</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var createdAt = DateTime.SpecifyKind(item.CreatedAt, DateTimeKind.Utc).ToLocalTime();
                            <tr>
                                <td class="ps-4 fw-semibold">#@item.EnrollmentId</td>
                                <td>@item.StudentName</td>
                                <td>
                                    <div class="fw-semibold">@item.ClassName</div>
                                    <div class="small text-muted">@item.SubjectName</div>
                                </td>
                                <td>@createdAt.ToString("HH:mm dd/MM/yyyy")</td>
                                <td>@item.Fee.ToString("N0") đ</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case EnrollmentStatus.PendingPayment:
                                            if (item.ReservedUntil.HasValue && item.ReservedUntil.Value > DateTime.UtcNow)
                                            {
                                                <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Hết thời gian giữ chỗ</span>
                                            }
                                            break;
                                        case EnrollmentStatus.Confirm:
                                            <span class="badge bg-success">Đã thanh toán</span>
                                            break;
                                        case EnrollmentStatus.Expried:
                                            <span class="badge bg-secondary">Hết hạn</span>
                                            break;
                                        case EnrollmentStatus.PaymentFailed:
                                            <span class="badge bg-danger">Thanh toán thất bại</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Đã hủy</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
