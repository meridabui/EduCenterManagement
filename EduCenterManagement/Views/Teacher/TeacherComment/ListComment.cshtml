@model EduCenterManagement.ViewModels.Teacher.Comment.ClassStudentCommentListViewModel

@{
    ViewData["Title"] = "Nhận xét học sinh theo lớp";
}

<div class="container-fluid py-2">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a asp-controller="Teacher" asp-action="AssignedClasses" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách lớp
            </a>
            <h2 class="mb-1">
                <i class="bi bi-chat-left-text text-primary me-2"></i>Nhận xét học sinh
            </h2>
            <p class="text-muted mb-0">
                Giáo viên: <strong>@Model.TeacherName</strong> | Quản lý đánh giá và nhận xét học tập cho từng học sinh.
            </p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Bộ lọc chọn Lớp học -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="ListComment" id="classFilterForm" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label fw-semibold mb-1">
                        <i class="bi bi-funnel me-1 text-primary"></i>Chọn Lớp học phụ trách:
                    </label>
                    <select asp-for="SelectedClassId" asp-items="Model.Classes" class="form-select" id="selectClassDropdown"
                            onchange="document.getElementById('classFilterForm').submit();">
                        <option value="">-- Chọn lớp học --</option>
                    </select>
                </div>
                @if (Model.ClassId > 0)
                {
                    <div class="col-md-7 d-flex justify-content-md-end gap-2 align-self-end">
                        <a asp-controller="Teacher" asp-action="StudentList" asp-route-classId="@Model.ClassId" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-people me-1"></i>Xem danh sách học sinh
                        </a>
                        <a asp-controller="Teacher" asp-action="Sessions" asp-route-id="@Model.ClassId" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-calendar3 me-1"></i>Lộ trình buổi học
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    @if (Model.ClassId > 0)
    {
        <!-- Bảng danh sách học sinh kèm trạng thái nhận xét -->
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        Danh sách học sinh lớp <span class="text-primary">@Model.ClassName</span>
                    </h5>
                    <small class="text-muted">Môn học: <strong>@Model.SubjectName</strong> | Sĩ số: <strong>@Model.Students.Count</strong> học sinh</small>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.Students == null || !Model.Students.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-people text-muted" style="font-size: 3.5rem;"></i>
                        <h5 class="text-muted mt-3">Lớp học chưa có học sinh nào</h5>
                        <p class="text-muted small mb-0">Học sinh đăng ký vào lớp sẽ tự động xuất hiện tại đây.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;" class="text-center">#</th>
                                    <th style="width: 120px;">Mã HS</th>
                                    <th style="width: 220px;">Họ và tên</th>
                                    <th style="width: 140px;" class="text-center">Số nhận xét</th>
                                    <th>Nhận xét gần nhất</th>
                                    <th style="width: 160px;" class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int idx = 1; }
                                @foreach (var s in Model.Students)
                                {
                                    <tr>
                                        <td class="text-center text-muted fw-bold">@(idx++)</td>
                                        <td>
                                            <span class="badge bg-light text-dark border font-monospace">
                                                @s.StudentCode
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@s.FullName</div>
                                            @if (s.DateOfBirth.HasValue)
                                            {
                                                <small class="text-muted">📅 @s.DateOfBirth.Value.ToString("dd/MM/yyyy")</small>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (s.CommentCount > 0)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-chat-dots me-1"></i>@s.CommentCount nhận xét
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1">
                                                    Chưa có nhận xét
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(s.LatestCommentContent))
                                            {
                                                <div class="text-dark small text-truncate" style="max-width: 350px;" title="@s.LatestCommentContent">
                                                    "@s.LatestCommentContent"
                                                </div>
                                                @if (s.LatestCommentAt.HasValue)
                                                {
                                                    <small class="text-muted">
                                                        <i class="bi bi-clock me-1"></i>@s.LatestCommentAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                    </small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic small">--</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a asp-action="StudentComments" asp-route-classId="@Model.ClassId" asp-route-studentId="@s.StudentId" 
                                               class="btn btn-sm btn-primary">
                                                <i class="bi bi-chat-left-text me-1"></i>Xem & Nhận xét
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 bg-white text-center py-5">
            <div class="card-body">
                <i class="bi bi-journal-check text-muted" style="font-size: 3.5rem;"></i>
                <h5 class="mt-3">Vui lòng chọn một lớp học ở trên để quản lý nhận xét</h5>
                <p class="text-muted small mb-0">Hệ thống sẽ tải toàn bộ danh sách học sinh của lớp tương ứng.</p>
            </div>
        </div>
    }
</div>

