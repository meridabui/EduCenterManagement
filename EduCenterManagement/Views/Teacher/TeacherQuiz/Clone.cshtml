@model EduCenterManagement.ViewModels.Teacher.Quiz.CloneQuizViewModel

@{
    ViewData["Title"] = $"Nhân bản đề Quiz - {Model.SourceQuizTitle}";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <a asp-controller="TeacherQuiz" asp-action="QuizList" class="btn btn-outline-secondary btn-sm mb-3">
                    ⬅ Quay lại danh sách Quiz
                </a>
                <h2 class="mb-1"><i class="bi bi-copy text-primary me-2"></i>Nhân bản bài Quiz của đồng nghiệp</h2>
                <p class="text-muted">Sao chép toàn bộ nội dung câu hỏi và các đáp án trắc nghiệm sang lớp học do bạn phụ trách.</p>
            </div>

            <!-- Box tóm tắt bài thi nguồn -->
            <div class="alert alert-info border-info mb-4 shadow-sm" role="alert">
                <h6 class="alert-heading fw-bold mb-2"><i class="bi bi-info-circle-fill me-2"></i>Thông tin bài Quiz nguồn:</h6>
                <div class="row g-2 small text-dark">
                    <div class="col-md-6">
                        Tiêu đề: <strong>@Model.SourceQuizTitle</strong>
                    </div>
                    <div class="col-md-6">
                        Giáo viên biên soạn: <strong>@Model.SourceTeacherName</strong>
                    </div>
                    <div class="col-md-6">
                        Môn học: <strong>@Model.SourceSubjectName</strong>
                    </div>
                    <div class="col-md-6">
                        Số lượng câu hỏi sẽ sao chép: <span class="badge bg-primary">@Model.QuestionCount câu hỏi</span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-controller="TeacherQuiz" asp-action="Clone" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="SourceQuizId" />
                        <input type="hidden" asp-for="SourceQuizTitle" />
                        <input type="hidden" asp-for="SourceTeacherName" />
                        <input type="hidden" asp-for="SourceSubjectName" />
                        <input type="hidden" asp-for="QuestionCount" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Chọn lớp & buổi học mục tiêu -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="TargetClassId" class="form-label fw-semibold">Gán vào Lớp của bạn <span class="text-danger">*</span></label>
                                <select asp-for="TargetClassId" asp-items="Model.TargetClasses" class="form-select" id="targetClassSelect">
                                    <option value="">-- Chọn lớp học của bạn --</option>
                                </select>
                                <span asp-validation-for="TargetClassId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TargetSessionId" class="form-label fw-semibold">
                                    Gắn vào buổi học <span class="text-muted small fw-normal">(Không bắt buộc)</span>
                                </label>
                                <select asp-for="TargetSessionId" asp-items="Model.TargetSessions" class="form-select" id="targetSessionSelect">
                                    <option value="">-- Không gắn vào buổi học (Quiz chung của cả lớp) --</option>
                                </select>
                                <span asp-validation-for="TargetSessionId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Tên Quiz mới -->
                        <div class="mb-3">
                            <label asp-for="NewTitle" class="form-label fw-semibold">Tiêu đề Quiz mới <span class="text-danger">*</span></label>
                            <input asp-for="NewTitle" class="form-control" />
                            <span asp-validation-for="NewTitle" class="text-danger small"></span>
                        </div>

                        <!-- Thời lượng -->
                        <div class="mb-3">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold">Thời lượng làm bài (Phút) <span class="text-danger">*</span></label>
                            <div class="input-group" style="max-width: 250px;">
                                <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="1440" />
                                <span class="input-group-text">phút</span>
                            </div>
                            <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                        </div>

                        <!-- Thời gian mở & đóng -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="AvailableFrom" class="form-label fw-semibold">Thời gian mở</label>
                                <input asp-for="AvailableFrom" class="form-control" type="datetime-local"
                                       value="@Model.AvailableFrom.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="AvailableFrom" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AvailableUntil" class="form-label fw-semibold">Thời gian đóng</label>
                                <input asp-for="AvailableUntil" class="form-control" type="datetime-local"
                                       value="@Model.AvailableUntil.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="AvailableUntil" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="TeacherQuiz" asp-action="QuizList" class="btn btn-light">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-copy me-1"></i> Xác nhận nhân bản bài Quiz
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('targetClassSelect').addEventListener('change', function() {
            var classId = this.value;
            var sessionSelect = document.getElementById('targetSessionSelect');
            sessionSelect.innerHTML = '<option value="">-- Đang tải buổi học... --</option>';

            if (!classId) {
                sessionSelect.innerHTML = '<option value="">-- Không gắn vào buổi học (Quiz chung của cả lớp) --</option>';
                return;
            }

            fetch('/Teacher/TeacherQuiz/GetSessionsByClass?classId=' + classId)
                .then(response => response.json())
                .then(data => {
                    sessionSelect.innerHTML = '';
                    data.forEach(function(s) {
                        var opt = document.createElement('option');
                        opt.value = s.id;
                        opt.textContent = s.text;
                        sessionSelect.appendChild(opt);
                    });
                })
                .catch(error => {
                    sessionSelect.innerHTML = '<option value="">-- Lỗi tải danh sách --</option>';
                });
        });
    </script>
}
