@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-edit-question').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var qId = this.getAttribute('data-id');
                    var qText = this.getAttribute('data-text');
                    var qPoints = this.getAttribute('data-points');
                    var options = JSON.parse(this.getAttribute('data-options') || '[]');

                    document.getElementById('editQuestionId').value = qId;
                    document.getElementById('editQuestionText').value = qText;
                    document.getElementById('editQuestionPoints').value = qPoints;

                    for (var i = 0; i < 4; i++) {
                        var optTextElem = document.getElementById('editOptionText' + i);
                        var optRadioElem = document.getElementById('editRadio' + i);
                        if (optTextElem && optRadioElem) {
                            if (i < options.length) {
                                optTextElem.value = options[i].OptionText || '';
                                if (options[i].IsCorrect) {
                                    optRadioElem.checked = true;
                                }
                            } else {
                                optTextElem.value = '';
                                optRadioElem.checked = false;
                            }
                        }
                    }

                    var modal = new bootstrap.Modal(document.getElementById('editQuestionModal'));
                    modal.show();
                });
            });

            // Bộ lọc danh sách học sinh (Tất cả / Đã làm / Chưa làm)
            var filterBtns = document.querySelectorAll('#studentResultFilter button');
            var studentRows = document.querySelectorAll('#tableStudentResults .student-row');

            filterBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    var filter = this.getAttribute('data-filter');
                    studentRows.forEach(function (row) {
                        var status = row.getAttribute('data-status');
                        if (filter === 'all' || status === filter) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
}

