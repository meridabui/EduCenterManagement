@using EduCenterManagement.Enums
@model EduCenterManagement.ViewModels.Teacher.Quiz.QuizDetailViewModel

@{
    ViewData["Title"] = $"Chi tiết Quiz - {Model.Title}";
}

<div class="container-fluid">
    <!-- Nút quay lại & Tiêu đề -->
    <div class="mb-4">
        <a asp-controller="TeacherQuiz" asp-action="QuizList" class="btn btn-outline-secondary btn-sm mb-3">
            ⬅ Quay lại danh sách Quiz
        </a>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="mb-0">@Model.Title</h2>
                    @switch (Model.Status)
                    {
                        case QuizStatus.Published:
                            <span class="badge bg-success">Xuất bản</span>
                            break;
                        case QuizStatus.Closed:
                            <span class="badge bg-dark">Đã đóng</span>
                            break;
                        default:
                            <span class="badge bg-warning text-dark">Bản nháp</span>
                            break;
                    }
                </div>
                <p class="text-muted mb-0">
                    Môn: <strong class="text-primary">@Model.SubjectName</strong> |
                    Lớp: <strong>@Model.ClassName</strong>
                    @if (Model.SessionNumber.HasValue)
                    {
                        <span>(Buổi @Model.SessionNumber.Value - @Model.SessionDate?.ToString("dd/MM/yyyy"))</span>
                    }
                    else
                    {
                        <span class="badge bg-info-subtle text-info border border-info ms-1">Quiz chung của lớp</span>
                    } |
                    Người ra đề: <strong>@(Model.IsMine ? "Tôi" : Model.CreatedByTeacherName)</strong>
                </p>
            </div>

            <!-- Các nút hành động chính -->
            <div class="d-flex flex-wrap gap-2">
                @if (Model.IsMine)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editQuizConfigModal">
                        <i class="bi bi-sliders me-1"></i> Sửa cấu hình
                    </button>

                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-gear me-1"></i> Trạng thái phát hành
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-controller="TeacherQuiz" asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="quizId" value="@Model.Id" />
                                    <input type="hidden" name="status" value="@QuizStatus.Published" />
                                    <button type="submit" class="dropdown-item text-success @(Model.Status == QuizStatus.Published ? "active" : "")">
                                        <i class="bi bi-play-circle me-2"></i> Xuất bản (Mở làm bài)
                                    </button>
                                </form>
                            </li>
                            <li>
                                <form asp-controller="TeacherQuiz" asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="quizId" value="@Model.Id" />
                                    <input type="hidden" name="status" value="@QuizStatus.Draft" />
                                    <button type="submit" class="dropdown-item text-warning @(Model.Status == QuizStatus.Draft ? "active" : "")">
                                        <i class="bi bi-pencil me-2"></i> Chuyển về Bản nháp
                                    </button>
                                </form>
                            </li>
                            <li>
                                <form asp-controller="TeacherQuiz" asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="quizId" value="@Model.Id" />
                                    <input type="hidden" name="status" value="@QuizStatus.Closed" />
                                    <button type="submit" class="dropdown-item text-dark @(Model.Status == QuizStatus.Closed ? "active" : "")">
                                        <i class="bi bi-lock me-2"></i> Đóng bài Quiz
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>

                    @if (!Model.Attempts.Any())
                    {
                        <form asp-controller="TeacherQuiz" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài Quiz này? Toàn bộ câu hỏi sẽ bị xóa.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i> Xóa Quiz
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm disabled" title="Đã có học sinh làm bài, không thể xóa">
                            <i class="bi bi-trash me-1"></i> Xóa Quiz
                        </button>
                    }
                }
                else
                {
                    <a asp-controller="TeacherQuiz" asp-action="Clone" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                        <i class="bi bi-copy me-1"></i> Sao chép đề này sang lớp của tôi
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Thống kê thông tin cấu hình Quiz -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 text-center p-3">
                <div class="text-muted small">Thời lượng làm bài</div>
                <div class="fs-4 fw-bold text-primary">@Model.DurationMinutes phút</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 text-center p-3">
                <div class="text-muted small">Số câu hỏi</div>
                <div class="fs-4 fw-bold text-dark">@Model.Questions.Count câu</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 text-center p-3">
                <div class="text-muted small">Tổng điểm bài thi</div>
                <div class="fs-4 fw-bold text-success">@Model.TotalPoints.ToString("0.##") đ</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 text-center p-3">
                <div class="text-muted small">Thời gian mở - đóng</div>
                <div class="small fw-bold text-secondary mt-1">
                    @Model.AvailableFrom.ToString("dd/MM/yyyy HH:mm") <br />đến @Model.AvailableUntil.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs: 1. Đề thi & Đáp án | 2. Kết quả học sinh -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs card-header-tabs m-0 px-3 border-bottom-0" role="tablist">
                <li class="nav-item">
                    <a class="nav-link py-3 px-4 @(Model.ActiveTab == "questions" ? "active fw-bold text-primary" : "text-secondary")"
                       href="#tabQuestions" data-bs-toggle="tab" role="tab">
                        <i class="bi bi-card-checklist me-1"></i> Nội dung Đề thi & Đáp án (@Model.Questions.Count)
                    </a>
                </li>
                @if (Model.IsMine)
                {
                    <li class="nav-item">
                        <a class="nav-link py-3 px-4 @(Model.ActiveTab == "results" ? "active fw-bold text-primary" : "text-secondary")"
                           href="#tabResults" data-bs-toggle="tab" role="tab">
                            <i class="bi bi-trophy me-1"></i> Bảng điểm học sinh (@Model.Attempts.Count)
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content">
                <!-- TAB 1: DANH SÁCH CÂU HỎI VÀ ĐÁP ÁN -->
                <div class="tab-pane fade @(Model.ActiveTab == "questions" ? "show active" : "")" id="tabQuestions" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Danh sách các câu hỏi trắc nghiệm</h5>
                        @if (Model.IsMine)
                        {
                            if (!Model.Attempts.Any())
                            {
                                <button type="button" class="btn btn-success btn-sm px-3" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
                                    <i class="bi bi-plus-lg me-1"></i> Thêm câu hỏi mới
                                </button>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2">
                                    <i class="bi bi-lock-fill me-1"></i> Đã có học sinh làm bài (Khóa thêm/sửa/xóa câu hỏi)
                                </span>
                            }
                        }
                    </div>

                    @if (Model.Questions.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @for (int i = 0; i < Model.Questions.Count; i++)
                            {
                                var q = Model.Questions[i];
                                <div class="card border border-light-subtle shadow-xs">
                                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                        <div class="fw-bold text-dark">
                                            <span class="badge bg-primary me-2">Câu @(i + 1)</span>
                                            <span>Điểm: @q.Points.ToString("0.##")</span>
                                        </div>
                                        @if (Model.IsMine && !Model.Attempts.Any())
                                        {
                                            <div class="d-flex gap-1">
                                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 btn-edit-question"
                                                        data-id="@q.Id"
                                                        data-text="@q.QuestionText"
                                                        data-points="@q.Points.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-options='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(q.Options))'
                                                        title="Sửa câu hỏi">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-controller="TeacherQuiz" asp-action="DeleteQuestion" method="post" class="d-inline"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa câu hỏi này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="questionId" value="@q.Id" />
                                                    <input type="hidden" name="quizId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Xóa câu hỏi">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                    <div class="card-body">
                                        <p class="fs-6 fw-semibold mb-3">@q.QuestionText</p>

                                        <div class="row g-2">
                                            @foreach (var opt in q.Options)
                                            {
                                                <div class="col-md-6">
                                                    <div class="p-2 rounded border @(opt.IsCorrect ? "bg-success-subtle border-success text-success fw-bold" : "bg-white") d-flex align-items-center justify-content-between">
                                                        <div>
                                                            <span class="badge @(opt.IsCorrect ? "bg-success" : "bg-secondary") me-2">
                                                                @(opt.SortOrder switch { 1 => "A", 2 => "B", 3 => "C", 4 => "D", _ => opt.SortOrder.ToString() })
                                                            </span>
                                                            <span>@opt.OptionText</span>
                                                        </div>
                                                        @if (opt.IsCorrect)
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success ms-2">
                                                                <i class="bi bi-check2-circle me-1"></i>Đáp án đúng
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 border rounded bg-light">
                            <i class="bi bi-question-diamond fs-1 text-secondary d-block mb-2"></i>
                            <p class="text-muted mb-2">Chưa có câu hỏi nào trong bài Quiz này.</p>
                            @if (Model.IsMine && !Model.Attempts.Any())
                            {
                                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
                                    <i class="bi bi-plus-lg me-1"></i> Thêm câu hỏi đầu tiên
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- TAB 2: BẢNG ĐIỂM HỌC SINH -->
                @if (Model.IsMine)
                {
                    <div class="tab-pane fade @(Model.ActiveTab == "results" ? "show active" : "")" id="tabResults" role="tabpanel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div>
                                <h5 class="fw-bold mb-1">Bảng tổng hợp kết quả Quiz - Lớp @Model.ClassName</h5>
                                <div class="text-muted small">
                                    Sĩ số lớp: <strong class="text-dark">@Model.TotalClassStudents</strong> em |
                                    Đã làm bài: <strong class="text-success">@Model.TotalAttemptedStudents</strong> em |
                                    Chưa làm bài: <strong class="text-danger">@Model.TotalNotAttemptedStudents</strong> em
                                </div>
                            </div>
                            <div class="btn-group btn-group-sm" role="group" id="studentResultFilter">
                                <button type="button" class="btn btn-outline-primary active" data-filter="all">Tất cả (@Model.StudentResults.Count)</button>
                                <button type="button" class="btn btn-outline-success" data-filter="attempted">Đã làm (@Model.TotalAttemptedStudents)</button>
                                <button type="button" class="btn btn-outline-danger" data-filter="not-attempted">Chưa làm (@Model.TotalNotAttemptedStudents)</button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="tableStudentResults">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Mã HS</th>
                                        <th>Họ và tên</th>
                                        <th>Trạng thái</th>
                                        <th>Số lượt làm</th>
                                        <th>Điểm chốt (Cao nhất)</th>
                                        <th>Thời gian nộp</th>
                                        <th class="pe-3 text-end">Chi tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.StudentResults.Any())
                                    {
                                        foreach (var s in Model.StudentResults)
                                        {
                                            <tr class="student-row" data-status="@(s.HasAttempted ? "attempted" : "not-attempted")">
                                                <td class="ps-3 font-monospace fw-bold text-secondary">@s.StudentCode</td>
                                                <td class="fw-semibold">@s.StudentFullName</td>
                                                <td>
                                                    @if (!s.HasAttempted)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger">
                                                            <i class="bi bi-x-circle me-1"></i>Chưa làm bài
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        switch (s.LatestStatus)
                                                        {
                                                            case QuizAttemptStatus.Submitted:
                                                                <span class="badge bg-success-subtle text-success border border-success">
                                                                    <i class="bi bi-check-circle me-1"></i>Đã nộp bài
                                                                </span>
                                                                break;
                                                            case QuizAttemptStatus.AutoSubmitted:
                                                                <span class="badge bg-info-subtle text-info border border-info">
                                                                    <i class="bi bi-robot me-1"></i>Tự động nộp
                                                                </span>
                                                                break;
                                                            case QuizAttemptStatus.Expired:
                                                                <span class="badge bg-secondary-subtle text-secondary border">
                                                                    <i class="bi bi-clock-history me-1"></i>Hết giờ
                                                                </span>
                                                                break;
                                                            default:
                                                                <span class="badge bg-warning-subtle text-warning border">
                                                                    <i class="bi bi-pencil me-1"></i>Đang làm
                                                                </span>
                                                                break;
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    @if (s.HasAttempted)
                                                    {
                                                        <span class="badge bg-light text-dark border">@s.AttemptsUsed / @Model.MaxAttempts lần</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">0 / @Model.MaxAttempts</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (s.BestScore.HasValue)
                                                    {
                                                        <span class="fs-6 fw-bold @(s.BestScore.Value >= (s.MaxScore / 2) ? "text-success" : "text-danger")">
                                                            @s.BestScore.Value.ToString("0.##") / @s.MaxScore.ToString("0.##")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">--</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (s.LatestSubmittedAt.HasValue)
                                                    {
                                                        <span>📅 @s.LatestSubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">--</span>
                                                    }
                                                </td>
                                                <td class="pe-3 text-end">
                                                    @if (s.BestAttemptId.HasValue)
                                                    {
                                                        <a asp-controller="TeacherQuiz" asp-action="StudentAttempt" asp-route-attemptId="@s.BestAttemptId.Value"
                                                           class="btn btn-outline-primary btn-sm">
                                                            <i class="bi bi-journal-text me-1"></i> Xem bài nộp
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small fst-italic">Chưa có bài nộp</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                <i class="bi bi-people fs-3 d-block mb-1"></i>
                                                Chưa có học sinh nào trong danh sách lớp.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.IsMine)
{
    <!-- Modal Sửa cấu hình Quiz -->
    <div class="modal fade" id="editQuizConfigModal" tabindex="-1" aria-labelledby="editQuizConfigModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-controller="TeacherQuiz" asp-action="EditConfig" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="QuizId" value="@Model.Id" />

                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="editQuizConfigModalLabel">
                            <i class="bi bi-sliders text-primary me-2"></i>Chỉnh sửa cấu hình bài Quiz
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>

                    <div class="modal-body p-4">
                        @if (Model.Attempts.Any())
                        {
                            <div class="alert alert-warning py-2 small mb-3">
                                <i class="bi bi-info-circle-fill me-1"></i>
                                Bài Quiz đã có học sinh làm bài: Bạn được sửa Tiêu đề, Thời lượng làm bài, Thời gian đóng và Số lần làm tối đa. Thời gian mở được giữ nguyên.
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tiêu đề bài Quiz <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control" value="@Model.Title" required maxlength="200" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Thời lượng làm bài (phút) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" min="1" max="300" name="DurationMinutes" class="form-control" value="@Model.DurationMinutes" required />
                                    <span class="input-group-text">phút</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số lần làm bài tối đa <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" min="1" max="10" name="MaxAttempts" class="form-control" value="@Model.MaxAttempts" required />
                                    <span class="input-group-text">lần</span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Thời gian mở làm bài <span class="text-danger">*</span></label>
                                <input type="datetime-local" name="AvailableFrom" class="form-control"
                                       value="@Model.AvailableFrom.ToString("yyyy-MM-ddTHH:mm")"
                                       @(Model.Attempts.Any() ? "readonly" : "") required />
                                @if (Model.Attempts.Any())
                                {
                                    <span class="text-muted small">Cố định do đã có học sinh làm bài.</span>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Thời gian đóng bài thi <span class="text-danger">*</span></label>
                                <input type="datetime-local" name="AvailableUntil" class="form-control"
                                       value="@Model.AvailableUntil.ToString("yyyy-MM-ddTHH:mm")" required />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (!Model.Attempts.Any())
    {
        <!-- Modal Thêm câu hỏi mới -->
        <div class="modal fade" id="addQuestionModal" tabindex="-1" aria-labelledby="addQuestionModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form asp-controller="TeacherQuiz" asp-action="AddQuestion" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="QuizId" value="@Model.Id" />

                        <div class="modal-header">
                            <h5 class="modal-title fw-bold" id="addQuestionModalLabel">
